<style>

  body{
    background:#f1f5f9;
    font-family:'Poppins',sans-serif;
  }

  /* =========================
     PAGE
  ========================= */

  .account-page{
    width:100%;
  }

  /* =========================
     HERO
  ========================= */

  .profile-hero{

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #1e3a8a
      );

    border-radius:32px;

    padding:40px;

    color:white;

    position:relative;

    overflow:hidden;

    box-shadow:
      0 20px 50px rgba(37,99,235,0.22);

  }

  .profile-hero::before{

    content:"";

    position:absolute;

    width:320px;
    height:320px;

    border-radius:50%;

    background:
      rgba(255,255,255,0.08);

    top:-120px;
    right:-120px;

  }

  .profile-avatar{

    width:120px;
    height:120px;

    border-radius:35px;

    background:white;

    color:#2563eb;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:44px;
    font-weight:700;

    box-shadow:
      0 18px 40px rgba(0,0,0,0.18);

  }

  .profile-name{
    font-size:34px;
    font-weight:700;
    margin-bottom:10px;
  }

  .profile-info{
    opacity:0.92;
    font-size:15px;
  }

  .verified-badge{

    display:inline-flex;
    align-items:center;
    gap:8px;

    background:#22c55e;

    padding:10px 16px;

    border-radius:30px;

    font-size:14px;
    font-weight:600;

    margin-top:18px;

  }

  /* =========================
     CARD
  ========================= */

  .modern-card{

    background:white;

    border-radius:30px;

    padding:30px;

    border:1px solid #e2e8f0;

    box-shadow:
      0 10px 40px rgba(15,23,42,0.05);

  }

  .section-title{
    font-size:24px;
    font-weight:700;
    color:#0f172a;
  }

  /* =========================
     STATS
  ========================= */

  .stat-card{

    background:white;

    border-radius:26px;

    padding:28px 24px;

    text-align:center;

    border:1px solid #e2e8f0;

    box-shadow:
      0 8px 30px rgba(15,23,42,0.05);

    transition:0.25s ease;

    height:100%;

  }

  .stat-card:hover{
    transform:translateY(-5px);
  }

  .stat-icon{

    width:68px;
    height:68px;

    border-radius:22px;

    background:#eff6ff;

    color:#2563eb;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:30px;

    margin:auto auto 18px;

  }

  .stat-number{
    font-size:30px;
    font-weight:700;
    color:#0f172a;
  }

  .stat-label{
    font-size:14px;
    color:#64748b;
    margin-top:6px;
  }

  /* =========================
     FORM
  ========================= */

  .form-label{
    font-weight:600;
    color:#0f172a;
    margin-bottom:10px;
  }

  .form-control{

    height:56px;

    border-radius:18px;

    border:1px solid #dbeafe;

    background:#f8fafc;

    padding:14px 18px;

    font-size:15px;

  }

  .form-control:focus{

    border-color:#2563eb;

    background:white;

    box-shadow:none;

  }

  .save-btn{

    height:54px;

    border:none;

    border-radius:18px;

    padding:0 28px;

    font-weight:600;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
      );

  }

  /* =========================
     COURSE LIST
  ========================= */

  .course-list-item{

    background:#f8fafc;

    border:1px solid #e2e8f0;

    border-radius:24px;

    padding:20px 22px;

    display:flex;
    justify-content:space-between;
    align-items:center;

    gap:18px;

    transition:0.25s ease;

  }

  .course-list-item:hover{

    transform:translateY(-4px);

    background:white;

    box-shadow:
      0 12px 30px rgba(15,23,42,0.05);

  }

  .course-left{
    display:flex;
    align-items:center;
    gap:16px;
  }

  .course-number{

    width:60px;
    height:60px;

    border-radius:20px;

    background:
      linear-gradient(
        135deg,
        #2563eb,
        #4f46e5
      );

    color:white;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:22px;
    font-weight:700;

    flex-shrink:0;

  }

  .course-title{
    font-size:18px;
    font-weight:700;
    color:#0f172a;
    margin-bottom:4px;
  }

  .modern-btn{

    height:50px;

    border-radius:16px;

    padding:0 22px;

    display:flex;
    align-items:center;
    justify-content:center;

    font-weight:600;

  }

  /* =========================
     SETTINGS
  ========================= */

  .settings-btn{

    height:56px;

    border-radius:18px;

    font-weight:600;

    display:flex;
    align-items:center;
    justify-content:center;
    gap:10px;

  }

/* =========================
   MOBILE APP DESIGN
========================= */

/* =========================
   FINAL MOBILE APP UI
========================= */

@media(max-width:768px){

  body{
    background:#eef2f7;
  }

  .account-page{
    padding:0 1px 20px;
  }

  /* =========================
     HERO SECTION
  ========================= */

  .profile-hero{

    padding:15px !important;

    border-radius:24px !important;

    margin-bottom:14px !important;

    box-shadow:
      0 8px 24px rgba(37,99,235,0.12) !important;

  }

  .profile-hero::before{

    width:150px;
    height:150px;

    top:-50px;
    right:-50px;

  }

  .profile-hero .row{

    display:flex;
    align-items:center;
    flex-wrap:nowrap;

    gap:12px;

  }

  .profile-hero .col-md-2,
  .profile-hero .col-md-10{

    width:auto !important;

    flex:unset !important;

    padding:0 !important;

    margin:0 !important;

  }

  .profile-avatar{

    width:62px !important;
    height:62px !important;

    border-radius:18px !important;

    font-size:22px !important;

    margin:0 !important;
margin-left: 20px !important;
    flex-shrink:0;

    box-shadow:
      0 10px 24px rgba(0,0,0,0.15);

  }

  .profile-name{

    font-size:16px !important;

    line-height:1.3;

    margin-bottom:2px !important;

  }

  .profile-info{

    font-size:10px !important;

    line-height:1.5;

    opacity:0.92;

    margin-bottom:0 !important;

    word-break:break-word;

  }

  .verified-badge{

    padding:5px 10px !important;

    border-radius:10px !important;

    font-size:10px !important;

    margin-top:7px !important;

    gap:4px !important;

    font-weight:600;

  }

  /* =========================
     MODERN CARD
  ========================= */

  .modern-card{

    padding:15px !important;

    border-radius:22px !important;

    margin-bottom:14px !important;

    border:none !important;

    box-shadow:
      0 5px 20px rgba(15,23,42,0.04) !important;

  }

  .section-title{

    font-size:16px !important;

    line-height:1.3;

  }

  /* =========================
     STATS
  ========================= */

  .row.mb-4{

    margin-left:-4px;
    margin-right:-4px;

  }

  .row.mb-4 > .col-xl-3,
  .row.mb-4 > .col-md-6{

    width:50%;

    padding-left:4px;
    padding-right:4px;

  }

  .stat-card{

    border-radius:20px !important;

    padding:14px 8px !important;

    min-height:125px;

    border:none !important;

    box-shadow:
      0 4px 14px rgba(15,23,42,0.04) !important;

  }

  .stat-icon{

    width:40px !important;
    height:40px !important;

    border-radius:14px !important;

    font-size:16px !important;

    margin-bottom:8px !important;

  }

  .stat-number{

    font-size:18px !important;

    line-height:1.2;

  }

  .stat-label{

    font-size:10px !important;

    line-height:1.4;

    margin-top:3px !important;

  }

  /* =========================
     FORM
  ========================= */

  .form-label{

    font-size:12px !important;

    margin-bottom:6px !important;

  }

  .form-control{

    height:46px !important;

    border-radius:13px !important;

    padding:10px 13px !important;

    font-size:13px !important;

  }

  .save-btn{

    width:100%;

    height:46px !important;

    border-radius:13px !important;

    font-size:13px !important;

  }

  /* =========================
     COURSE & REWARD CARDS
  ========================= */

  .course-list-item{

    flex-direction:column !important;

    align-items:flex-start !important;

    gap:12px !important;

    padding:13px !important;

    border-radius:18px !important;

    border:none !important;

  }

  .course-left{

    width:100%;

    gap:10px !important;

  }

  .course-number{

    width:42px !important;
    height:42px !important;

    border-radius:14px !important;

    font-size:15px !important;

  }

  .course-title{

    font-size:13px !important;

    line-height:1.4;

    margin-bottom:1px !important;

  }

  .course-list-item small{

    font-size:10px !important;

    line-height:1.4;

  }

  .modern-btn{

    width:100%;

    height:42px !important;

    border-radius:12px !important;

    font-size:12px !important;

    font-weight:600;

  }

  /* =========================
     BADGES
  ========================= */

  .badge{

    padding:7px 10px !important;

    border-radius:10px !important;

    font-size:9px !important;

    font-weight:600 !important;

  }

  /* =========================
     SETTINGS
  ========================= */

  .settings-btn{

    height:46px !important;

    border-radius:13px !important;

    font-size:13px !important;

    gap:7px !important;

  }

  /* =========================
     SPACING
  ========================= */

  .mb-4{
    margin-bottom:14px !important;
  }

  .mb-3{
    margin-bottom:10px !important;
  }

  .gap-3{
    gap:10px !important;
  }

  .text-muted{
    font-size:10px !important;
  }

}

</style>

<div class="container-fluid account-page">

  <!-- HERO -->

  <div class="profile-hero mb-4">

    <div class="row align-items-center">

      <div class="col-md-2 text-center text-md-start">

        <div class="profile-avatar">
          <%= user.name.charAt(0).toUpperCase() %>
        </div>

      </div>

      <div class="col-md-10 mt-4 mt-md-0">

        <div class="profile-name">
          <%= user.name %>
        </div>

        <div class="profile-info mb-2">
          <i class="bi bi-envelope-fill"></i>
          <%= user.email %>
        </div>

        <% if(user.is_verified){ %>

          <div class="verified-badge">
            <i class="bi bi-patch-check-fill"></i>
            Verified Account
          </div>

        <% } %>

      </div>

    </div>

  </div>

  <!-- STATS -->

  <div class="row mb-4">

    <div class="col-xl-3 col-md-6 mb-3">

      <div class="stat-card">

        <div class="stat-icon">
          <i class="bi bi-book-fill"></i>
        </div>

        <div class="stat-number">
          <%= courses.length %>
        </div>

        <div class="stat-label">
          Courses Joined
        </div>

      </div>

    </div>

    <div class="col-xl-3 col-md-6 mb-3">

      <div class="stat-card">

        <div class="stat-icon">
          <i class="bi bi-check-circle-fill"></i>
        </div>

        <div class="stat-number">
          <%= completedVideos %>
        </div>

        <div class="stat-label">
          Lessons Completed
        </div>

      </div>

    </div>

    <div class="col-xl-3 col-md-6 mb-3">

      <div class="stat-card">

        <div class="stat-icon">
          <i class="bi bi-lightning-charge-fill"></i>
        </div>

        <div class="stat-number">
          <%= user.xp || 0 %>
        </div>

        <div class="stat-label">
          XP Earned
        </div>

      </div>

    </div>

    <div class="col-xl-3 col-md-6 mb-3">

      <div class="stat-card">

        <div class="stat-icon">
          <i class="bi bi-person-badge-fill"></i>
        </div>

        <div class="stat-number fs-4 text-capitalize">
          <%= user.role %>
        </div>

        <div class="stat-label">
          Account Type
        </div>

      </div>

    </div>

  </div>

  <!-- EDIT PROFILE -->

  <div class="modern-card mb-4">

    <div class="section-title mb-4">
      ✏️ Edit Profile
    </div>

    <form method="POST" action="/update-profile">

      <div class="row">

        <div class="col-md-6 mb-3">

          <label class="form-label">
            Full Name
          </label>

          <input
            type="text"
            name="name"
            value="<%= user.name %>"
            class="form-control"
            required
          >

        </div>

        <div class="col-md-6 mb-3">

          <label class="form-label">
            Email Address
          </label>

          <input
            type="email"
            name="email"
            value="<%= user.email %>"
            class="form-control"
            required
          >

        </div>

      </div>

      <button class="btn btn-primary save-btn mt-2">

        <i class="bi bi-check-circle-fill"></i>
        Save Changes

      </button>

    </form>

  </div>

  <!-- COURSES -->

  <div class="modern-card mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

      <div class="section-title">
        📚 Enrolled Courses
      </div>

      <span class="text-muted">
        <%= courses.length %> Courses
      </span>

    </div>

    <% if(courses.length > 0){ %>

      <div class="d-flex flex-column gap-3">

        <% courses.forEach((c,index)=>{ %>

          <div class="course-list-item">

            <div class="course-left">

              <div class="course-number">
                <%= index + 1 %>
              </div>

              <div>

                <div class="course-title">
                  <%= c.title %>
                </div>

                <small class="text-muted">
                  Enrolled Course
                </small>

              </div>

            </div>

            <a
              href="/course/<%= c.id %>"
              class="btn btn-dark modern-btn"
            >
              Open Course
            </a>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <div class="alert alert-light border rounded-4 mb-0">
        No enrolled courses found.
      </div>

    <% } %>

  </div>

  <!-- REWARD HISTORY -->

  <div class="modern-card mb-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

      <div class="section-title">
        🎡 Spin Reward History
      </div>

      <span class="text-muted">
        <%= spinRewards.length %> Rewards
      </span>

    </div>

    <% if(spinRewards.length > 0){ %>

      <div class="d-flex flex-column gap-3">

        <% spinRewards.forEach((r)=>{ %>

          <div class="course-list-item">

            <div class="course-left">

              <div
                class="course-number"
                style="
                  background:
                  linear-gradient(
                    135deg,
                    #7c3aed,
                    #2563eb
                  );
                "
              >
                🎁
              </div>

              <div>

                <div class="course-title text-capitalize">

                  <% if(r.reward_type === "xp"){ %>

                    +<%= r.reward_value %> XP Reward

                  <% } else if(r.reward_type === "premium_unlock"){ %>

                    Premium Unlock

                  <% } else if(r.reward_type === "double_xp"){ %>

                    Double XP Boost

                  <% } else if(r.reward_type === "quiz_unlock"){ %>

                    Bonus Quiz Unlock

                  <% } else { %>

                    Better Luck Next Time 😅

                  <% } %>

                </div>

                <small class="text-muted">

                  Won on
                  <%= new Date(
                    r.created_at
                  ).toLocaleString() %>

                </small>

              </div>

            </div>

            <div>

              <% if(r.reward_type === "xp"){ %>

                <span class="badge bg-success p-3">
                  +<%= r.reward_value %> XP
                </span>

              <% } else { %>

                <span class="badge bg-primary p-3">
                  Reward
                </span>

              <% } %>

            </div>

          </div>

        <% }) %>

      </div>

    <% } else { %>

      <div class="alert alert-light border rounded-4 mb-0">
        No spin rewards found yet.
      </div>

    <% } %>

  </div>

  <!-- SETTINGS -->

  <div class="modern-card">

    <div class="section-title mb-4">
      ⚙️ Account Settings
    </div>

    <div class="row">

      <div class="col-md-6 mb-3">

        <a
          href="/forgot-password"
          class="btn btn-outline-dark w-100 settings-btn"
        >
          <i class="bi bi-lock-fill"></i>
          Change Password
        </a>

      </div>

      <div class="col-md-6 mb-3">

        <a
          href="/logout"
          class="btn btn-danger w-100 settings-btn"
        >
          <i class="bi bi-box-arrow-right"></i>
          Logout
        </a>

      </div>

    </div>

  </div>

</div>