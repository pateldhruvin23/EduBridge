<!-- ================= SIGNUP PAGE ================= -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Signup</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background: linear-gradient(135deg, #0f172a, #1e293b, #334155);
      font-family: "Segoe UI", sans-serif;
      overflow:hidden;
      position:relative;
    }

    body::before{
      content:"";
      position:absolute;
      width:500px;
      height:500px;
      background:#2563eb;
      border-radius:50%;
      top:-200px;
      left:-150px;
      filter:blur(120px);
      opacity:0.4;
    }

    body::after{
      content:"";
      position:absolute;
      width:400px;
      height:400px;
      background:#7c3aed;
      border-radius:50%;
      bottom:-180px;
      right:-120px;
      filter:blur(120px);
      opacity:0.4;
    }

    .auth-container{
      width:100%;
      max-width:420px;
      padding:20px;
      position:relative;
      z-index:10;
    }

    .auth-card{
      background:rgba(255,255,255,0.1);
      backdrop-filter:blur(20px);
      border:1px solid rgba(255,255,255,0.15);
      border-radius:28px;
      padding:40px 30px;
      box-shadow:0 10px 40px rgba(0,0,0,0.25);
      color:white;
    }

    .logo-box{
      width:75px;
      height:75px;
      margin:auto;
      border-radius:20px;
      background:linear-gradient(135deg,#2563eb,#7c3aed);
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:34px;
      color:white;
      margin-bottom:20px;
      box-shadow:0 10px 25px rgba(37,99,235,0.4);
    }

    .auth-title{
      font-size:28px;
      font-weight:700;
    }

    .auth-subtitle{
      color:#cbd5e1;
      font-size:14px;
    }

    .input-group{
      background:rgba(255,255,255,0.08);
      border-radius:14px;
      overflow:hidden;
      border:1px solid rgba(255,255,255,0.08);
    }

    .input-group-text{
      background:transparent;
      border:none;
      color:#cbd5e1;
      padding-left:15px;
    }

    .form-control{
      background:transparent;
      border:none;
      color:white;
      height:52px;
    }

    .form-control::placeholder{
      color:#cbd5e1;
    }

    .form-control:focus{
      background:transparent;
      box-shadow:none;
      color:white;
    }

    .toggle-password{
      cursor:pointer;
    }

    .btn-auth{
      height:52px;
      border:none;
      border-radius:14px;
      background:linear-gradient(135deg,#2563eb,#7c3aed);
      font-weight:600;
      font-size:16px;
      transition:0.3s;
    }

    .btn-auth:hover{
      transform:translateY(-2px);
      box-shadow:0 8px 20px rgba(37,99,235,0.4);
    }

    a{
      color:#93c5fd;
      text-decoration:none;
    }

    a:hover{
      color:white;
    }

    .auth-footer{
      color:#cbd5e1;
      font-size:14px;
    }

    .alert{
      border-radius:12px;
    }
  </style>
</head>

<body>

<div class="auth-container">

  <div class="auth-card">

    <div class="text-center mb-4">
      <div class="logo-box">
        <i class="bi bi-book-half"></i>
      </div>
<h2 class="fw-bold">EduBridge</h2>
      <h2 class="auth-title">Create Account</h2>
      <p class="auth-subtitle">
        Start your professional learning journey
      </p>
    </div>

    <form method="POST" action="/signup">

      <!-- NAME -->
      <div class="input-group mb-3">
        <span class="input-group-text">
          <i class="bi bi-person-fill"></i>
        </span>

        <input
          type="text"
          name="name"
          class="form-control"
          placeholder="Full name"
          required
        />
      </div>

      <!-- EMAIL -->
      <div class="input-group mb-3">
        <span class="input-group-text">
          <i class="bi bi-envelope-fill"></i>
        </span>

        <input
          type="email"
          name="email"
          class="form-control"
          placeholder="Email address"
          required
        />
      </div>

      <!-- PASSWORD -->
      <div class="input-group mb-3">
        <span class="input-group-text">
          <i class="bi bi-lock-fill"></i>
        </span>

        <input
          type="password"
          id="signupPassword"
          name="password"
          class="form-control"
          placeholder="Password"
          required
        />

        <span class="input-group-text toggle-password" onclick="toggleSignupPassword()">
          <i class="bi bi-eye-fill" id="signupEye"></i>
        </span>
      </div>

      <!-- AGREEMENT -->

<!-- AGREEMENT -->

<div
  class="agreement-box mt-3 mb-4"
>

  <div class="form-check d-flex align-items-start gap-2">

    <input
      class="form-check-input mt-1"
      type="checkbox"
      id="agreeTerms"
      name="agreeTerms"
      required
    >

    <label
      class="form-check-label agreement-text"
      for="agreeTerms"
    >

      I agree to the

      <a
        href="/page/terms"
        target="_blank"
      >
        Terms & Conditions
      </a>

      and

      <a
        href="/page/privacy-policy"
        target="_blank"
      >
        Privacy Policy
      </a>

      of EduBridge.

    </label>

  </div>

</div>

<!-- BUTTON -->

<button
  class="btn btn-primary w-100 btn-auth"
>
  Create Account
</button>

    </form>

    <p class="text-center mt-4 auth-footer">
      Already have an account?
      <a href="/login">Sign in</a>
    </p>

    <% if (error) { %>
      <div class="alert alert-danger mt-3">
        <%= error %>
      </div>
    <% } %>

  </div>

</div>

<script>
function toggleSignupPassword() {
  const input = document.getElementById("signupPassword");
  const eye = document.getElementById("signupEye");

  if(input.type === "password"){
    input.type = "text";
    eye.classList.remove("bi-eye-fill");
    eye.classList.add("bi-eye-slash-fill");
  } else {
    input.type = "password";
    eye.classList.remove("bi-eye-slash-fill");
    eye.classList.add("bi-eye-fill");
  }
}
</script>

</body>
</html>