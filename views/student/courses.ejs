<style>

body{
  background:#f1f5f9;
  font-family:'Poppins',sans-serif;
  color:#0f172a;
}

/* =========================
   HEADER
========================= */

.page-header{
  background:linear-gradient(
    135deg,
    #2563eb,
    #1e3a8a
  );
  border-radius:30px;
  padding:35px;
  color:white;
  margin-bottom:35px;
  position:relative;
  overflow:hidden;
  box-shadow:0 20px 50px rgba(37,99,235,0.25);
}

.page-header::before{
  content:"";
  position:absolute;
  width:280px;
  height:280px;
  background:rgba(255,255,255,0.08);
  border-radius:50%;
  right:-80px;
  top:-80px;
}

.page-title{
  font-size:34px;
  font-weight:700;
  margin-bottom:8px;
}

.page-subtitle{
  opacity:0.85;
  margin:0;
}

/* =========================
   NOTIFICATION BUTTON
========================= */

.top-actions{
  position:absolute;
  top:30px;
  right:30px;
}

.bell-btn{
  width:55px;
  height:55px;
  border:none;
  border-radius:18px;
  background:rgba(255,255,255,0.18);
  backdrop-filter:blur(10px);
  color:white;
  font-size:20px;
  position:relative;
  transition:0.3s;
}

.bell-btn:hover{
  transform:translateY(-3px);
  background:rgba(255,255,255,0.28);
}

/* =========================
   BADGE
========================= */

#notifCount{
  font-size:11px;
  padding:5px 7px;
}

/* =========================
   NOTIFICATION PANEL
========================= */

.notification-panel{
  position:fixed;
  top:0;
  left:-380px;
  width:360px;
  height:100vh;
  background:white;
  z-index:9999;
  padding:25px;
  transition:0.4s;
  overflow-y:auto;
  box-shadow:10px 0 40px rgba(0,0,0,0.1);
}

.notification-panel.show{
  left:0;
}

.panel-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.close-btn{
  width:40px;
  height:40px;
  border-radius:12px;
  background:#f1f5f9;
  display:flex;
  align-items:center;
  justify-content:center;
  cursor:pointer;
  transition:0.3s;
}

.close-btn:hover{
  background:#e2e8f0;
}

/* =========================
   NOTIFICATION ITEM
========================= */

.notification-item{
  background:#f8fafc;
  border-radius:18px;
  padding:16px;
  margin-bottom:14px;
  transition:0.3s;
  border:1px solid #e2e8f0;
  cursor:pointer;
}

.notification-item:hover{
  background:white;
  transform:translateY(-2px);
  box-shadow:0 10px 25px rgba(0,0,0,0.05);
}

.notification-unread{
  border-left:5px solid #2563eb;
}

/* =========================
   COURSE CARD
========================= */

.course-card{
  background:white;
  border-radius:28px;
  overflow:hidden;
  position:relative;
  transition:0.35s;
  border:none;
  height:100%;
  box-shadow:0 10px 30px rgba(0,0,0,0.06);
}

.course-card:hover{
  transform:translateY(-8px);
  box-shadow:0 20px 45px rgba(0,0,0,0.12);
}

/* =========================
   IMAGE
========================= */

.course-thumb-wrapper{
  background:#f8fafc;
  padding:12px;
}

.course-thumb{
  width:100%;
  height:220px;
  object-fit:contain;
  border-radius:18px;
  background:white;
}

/* =========================
   BODY
========================= */

.course-body{
  padding:24px;
}

.course-title{
  font-size:22px;
  font-weight:700;
  margin-bottom:12px;
  color:#0f172a;
}

/* =========================
   BADGE
========================= */

.badge-modern{
  background:#dcfce7;
  color:#166534;
  padding:7px 12px;
  border-radius:12px;
  font-size:13px;
  font-weight:600;
}

/* =========================
   PROGRESS
========================= */

.progress{
  height:10px;
  border-radius:20px;
  background:#e2e8f0;
  overflow:hidden;
}

.progress-bar{
  background:linear-gradient(
    90deg,
    #22c55e,
    #16a34a
  );
  border-radius:20px;
}

/* =========================
   BUTTONS
========================= */

.btn-modern{
  border-radius:16px;
  padding:12px;
  font-weight:600;
  transition:0.3s;
}

.btn-modern:hover{
  transform:scale(1.02);
}




/* =========================
   EMPTY
========================= */

.empty-box{
  background:white;
  border-radius:24px;
  padding:60px 20px;
  text-align:center;
  box-shadow:0 10px 30px rgba(0,0,0,0.05);
}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

  .page-header{
    padding:28px 22px;
  }

  .page-title{
    font-size:28px;
  }

  .top-actions{
    position:static;
    margin-top:20px;
  }

  .notification-panel{
    width:100%;
    left:-100%;
  }

}

</style>

<!-- =========================
     HEADER
========================= -->

<div class="page-header">

  <div>

    <h1 class="page-title">
      📚 Your Courses
    </h1>

    <p class="page-subtitle">
      Continue learning and track your progress 🚀
    </p>

  </div>

  <!-- 🔔 NOTIFICATION -->

  <div class="top-actions">

    <button class="bell-btn" onclick="togglePanel()">

      <i class="bi bi-bell-fill"></i>

      <% const unreadCount = (notifications || []).filter(n => !n.is_read).length; %>

      <% if(unreadCount > 0){ %>

        <span
          id="notifCount"
          class="position-absolute top-0 start-100 translate-middle badge bg-danger rounded-pill"
        >
          <%= unreadCount %>
        </span>

      <% } %>

    </button>

  </div>

</div>

<!-- =========================
     NOTIFICATION PANEL
========================= -->

<div id="notificationPanel" class="notification-panel">

  <div class="panel-header">

    <h4 class="fw-bold mb-0">
      🔔 Notifications
    </h4>

    <div class="close-btn" onclick="togglePanel()">
      <i class="bi bi-x-lg"></i>
    </div>

  </div>

  <% if(!notifications || notifications.length === 0){ %>

    <p class="text-muted">
      No notifications available.
    </p>

  <% } %>

  <% (notifications || []).forEach(n => { %>

    <div
      class="notification-item <%= !n.is_read ? 'notification-unread' : '' %>"
      onclick="markAsRead(this,<%= n.notification_id %>)"
    >

      <div class="fw-semibold mb-1">
        EduBridge
      </div>

      <div class="small text-muted">
        <%= n.message %>
      </div>

      <% if(!n.is_read){ %>

        <small class="text-primary fw-semibold">
          New Notification
        </small>

      <% } %>

    </div>

  <% }) %>

</div>

<!-- =========================
     COURSES
========================= -->

<div class="row">

<% if(courses.length > 0){ %>

  <% courses.forEach(course => { %>

    <div class="col-xl-4 col-md-6 mb-4">

      <div class="course-card">

       

        <!-- IMAGE -->

        <div class="course-thumb-wrapper">

          <img
            src="<%= course.thumbnail || 'https://via.placeholder.com/400x200' %>"
            class="course-thumb"
          >

        </div>

        <!-- BODY -->

        <div class="course-body">

          <h5 class="course-title">
            <%= course.title %>
          </h5>
          <!-- XP BADGE -->

<% if(course.is_premium){ %>

  <div class="mb-2">

    <span class="badge bg-warning text-dark px-3 py-2">

      🏆 <%= course.xp_required %> XP Required

    </span>

  </div>

<% } %>

          <% if(enrolledIds.includes(course.id)){ %>

            <span class="badge-modern d-inline-block mb-3">
              ✔ Enrolled
            </span>

            <!-- PROGRESS -->

            <div class="progress mb-2">

              <div
                class="progress-bar"
                style="width:<%= progressMap[course.id] %>%"
              ></div>

            </div>

            <small class="text-muted">
              <%= progressMap[course.id] %>% Completed
            </small>

          <% } %>

          <div class="mt-4">

            <% if(enrolledIds.includes(course.id)){ %>

              <a
                href="/course/<%= course.id %>"
                class="btn btn-primary btn-modern w-100"
              >
                ▶ Continue Learning
              </a>

            <% } else { %>

              <% if(course.is_premium){ %>

  <% if(user.xp >= course.xp_required){ %>

    <form method="POST" action="/unlock-course">

      <input
        type="hidden"
        name="courseId"
        value="<%= course.id %>"
      >

      <button
        class="btn btn-warning btn-modern w-100"
      >

        🏆 Unlock For
        <%= course.xp_required %> XP

      </button>

    </form>

  <% } else { %>

    <button
      class="btn btn-secondary btn-modern w-100"
      disabled
    >

      🔒 Need
      <%= course.xp_required %> XP

    </button>

  <% } %>

<% } else { %>

  <form method="POST" action="/enroll">

    <input
      type="hidden"
      name="courseId"
      value="<%= course.id %>"
    >

    <button
      class="btn btn-success btn-modern w-100"
    >

      🎟️ Enroll Now

    </button>

  </form>

<% } %>

            <% } %>

          </div>

        </div>

      </div>

    </div>

  <% }) %>

<% } else { %>

  <div class="col-12">

    <div class="empty-box">

      <h4 class="fw-bold mb-3">
        No Courses Found
      </h4>

      <p class="text-muted mb-0">
        Courses will appear here once added.
      </p>

    </div>

  </div>

<% } %>

</div>

<script>

function togglePanel(){

  document
    .getElementById("notificationPanel")
    .classList
    .toggle("show");

}

async function markAsRead(el,id){

  const res = await fetch("/mark-read",{
    method:"POST",
    headers:{
      "Content-Type":"application/json"
    },
    body:JSON.stringify({
      notificationId:id
    })
  });

  const data = await res.json();

  if(data.success){

    el.classList.remove(
      "notification-unread"
    );

    const badge =
      el.querySelector("small");

    if(badge) badge.remove();

    const countEl =
      document.getElementById(
        "notifCount"
      );

    if(countEl){

      let count =
        parseInt(countEl.innerText);

      count--;

      if(count <= 0){
        countEl.remove();
      }else{
        countEl.innerText = count;
      }

    }

  }

}



</script>