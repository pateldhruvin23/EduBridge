<!-- ================= LOGIN PAGE ================= -->
<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>Login</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html{
  height:100%;
}

body{
  min-height:100dvh;
  display:flex;
  justify-content:center;
  align-items:center;
  background:linear-gradient(135deg,#0f172a,#1e293b,#334155);
  font-family:"Segoe UI",sans-serif;
  position:relative;
  overflow:hidden;
  padding:16px;
}

/* SAFE AREA FOR iPHONE */

@supports(padding:max(0px)){

  body{
    padding-top:max(16px, env(safe-area-inset-top));
    padding-bottom:max(16px, env(safe-area-inset-bottom));
    padding-left:max(16px, env(safe-area-inset-left));
    padding-right:max(16px, env(safe-area-inset-right));
  }

}

/* BACKGROUND GLOW */

body::before{
  content:"";
  position:absolute;
  width:500px;
  height:500px;
  background:#2563eb;
  border-radius:50%;
  top:-220px;
  left:-180px;
  filter:blur(120px);
  opacity:0.45;
  z-index:0;
}

body::after{
  content:"";
  position:absolute;
  width:420px;
  height:420px;
  background:#7c3aed;
  border-radius:50%;
  bottom:-220px;
  right:-160px;
  filter:blur(120px);
  opacity:0.45;
  z-index:0;
}

/* CONTAINER */

.auth-container{
  width:100%;
  max-width:430px;
  position:relative;
  z-index:10;

  display:flex;
  justify-content:center;
  align-items:center;
}

/* CARD */

.auth-card{
  width:100%;
  background:rgba(255,255,255,0.1);
  backdrop-filter:blur(22px);
  -webkit-backdrop-filter:blur(22px);

  border:1px solid rgba(255,255,255,0.12);

  border-radius:32px;

  padding:38px 28px;

  box-shadow:
    0 10px 40px rgba(0,0,0,0.25),
    inset 0 1px 1px rgba(255,255,255,0.08);

  color:white;

  max-height:calc(100dvh - 32px);

  overflow-y:auto;

  scrollbar-width:none;
}

.auth-card::-webkit-scrollbar{
  display:none;
}

/* LOGO */

.logo-box{
  width:82px;
  height:82px;

  margin:auto;

  border-radius:24px;

  background:linear-gradient(135deg,#2563eb,#7c3aed);

  display:flex;
  align-items:center;
  justify-content:center;

  font-size:36px;
  color:white;

  margin-bottom:20px;

  box-shadow:0 10px 30px rgba(37,99,235,0.45);
}

/* TITLES */

.brand-title{
  font-size:32px;
  font-weight:800;
  margin-bottom:4px;
  letter-spacing:0.5px;
}

.auth-title{
  font-size:24px;
  font-weight:700;
  margin-bottom:8px;
}

.auth-subtitle{
  color:#cbd5e1;
  font-size:14px;
  line-height:1.5;
}

/* INPUTS */

.input-group{
  background:rgba(255,255,255,0.08);

  border-radius:18px;

  overflow:hidden;

  border:1px solid rgba(255,255,255,0.08);

  transition:0.25s ease;
}

.input-group:focus-within{
  border-color:rgba(147,197,253,0.7);

  box-shadow:0 0 0 4px rgba(59,130,246,0.15);

  transform:translateY(-1px);
}

.input-group-text{
  background:transparent;
  border:none;

  color:#cbd5e1;

  padding-left:16px;
  padding-right:10px;

  font-size:18px;
}

.form-control{
  background:transparent !important;
  border:none !important;

  color:white !important;

  height:58px;

  font-size:16px;

  box-shadow:none !important;
}

.form-control::placeholder{
  color:#cbd5e1;
  opacity:0.9;
}

.form-control:focus{
  background:transparent !important;
}

/* PASSWORD ICON */

.toggle-password{
  cursor:pointer;
  user-select:none;
  touch-action:manipulation;
}

/* AGREEMENT */

.agreement-box{
  background:rgba(255,255,255,0.05);

  border:1px solid rgba(255,255,255,0.08);

  border-radius:16px;

  padding:14px;
}

.agreement-text{
  font-size:14px;
  color:#e2e8f0;
  line-height:1.5;
}

.form-check-input{
  width:18px;
  height:18px;
  border-radius:6px !important;
  cursor:pointer;
}

/* BUTTON */

.btn-auth{
  height:58px;

  border:none;

  border-radius:18px;

  background:linear-gradient(135deg,#2563eb,#7c3aed);

  font-weight:700;

  font-size:16px;

  transition:0.25s ease;

  letter-spacing:0.3px;
}

.btn-auth:hover{
  transform:translateY(-2px);

  box-shadow:0 10px 25px rgba(37,99,235,0.4);
}

.btn-auth:active{
  transform:scale(0.98);
}

/* LINKS */

a{
  color:#93c5fd;
  text-decoration:none;
  transition:0.2s;
}

a:hover{
  color:white;
}

.auth-footer{
  color:#cbd5e1;
  font-size:14px;
}

.alert{
  border-radius:16px;
  border:none;
}

/* TABLET */

@media(min-width:769px) and (max-width:1024px){

  .auth-container{
    max-width:500px;
  }

  .auth-card{
    padding:48px 38px;
  }

}

/* MOBILE */

@media(max-width:768px){

  body{
    padding:14px;
  }

  .auth-container{
    max-width:100%;
  }

  .auth-card{
    border-radius:28px;

    padding:28px 20px;

    max-height:calc(100dvh - 28px);
  }

  .brand-title{
    font-size:28px;
  }

  .auth-title{
    font-size:22px;
  }

}

/* SMALL MOBILE */

@media(max-width:480px){

  body{
    padding:12px;
  }

  .auth-card{
    padding:24px 18px;
    border-radius:24px;
  }

  .logo-box{
    width:68px;
    height:68px;
    font-size:30px;
    margin-bottom:16px;
  }

  .brand-title{
    font-size:24px;
  }

  .auth-title{
    font-size:20px;
  }

  .auth-subtitle{
    font-size:13px;
  }

  .form-control{
    height:54px;
    font-size:16px;
  }

  .btn-auth{
    height:54px;
  }

}

</style>

</head>

<body>

<div class="auth-container">

  <div class="auth-card">

    <div class="text-center mb-4">

      <div class="logo-box">
        <i class="bi bi-mortarboard-fill"></i>
      </div>

      <h2 class="brand-title">
        EduBridge
      </h2>

      <h2 class="auth-title">
        Welcome Back
      </h2>

      <p class="auth-subtitle">
        Login to continue your learning journey
      </p>

    </div>

    <form method="POST" action="/login">

      <!-- EMAIL -->
      <div class="input-group mb-3">

        <span class="input-group-text">
          <i class="bi bi-envelope-fill"></i>
        </span>

        <input
          type="email"
          name="email"
          class="form-control"
          placeholder="Email address"
          autocomplete="email"
          inputmode="email"
          autocapitalize="none"
          required
        />

      </div>

      <!-- PASSWORD -->
      <div class="input-group mb-3">

        <span class="input-group-text">
          <i class="bi bi-lock-fill"></i>
        </span>

        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          placeholder="Password"
          autocomplete="current-password"
          required
        />

        <span
          class="input-group-text toggle-password"
          onclick="togglePassword()"
        >
          <i class="bi bi-eye-fill" id="eyeIcon"></i>
        </span>

      </div>

      <div class="text-end mb-3">

        <a href="/forgot-password" class="small">
          Forgot password?
        </a>

      </div>

      <button class="btn btn-primary w-100 btn-auth">
        Login
      </button>

    </form>

    <p class="text-center mt-4 auth-footer">

      Don’t have an account?

      <a href="/signup">
        Create one
      </a>

    </p>

    <% if (error) { %>

      <div class="alert alert-danger mt-3">
        <%= error %>
      </div>

    <% } %>

  </div>

</div>

<script>

function togglePassword(){

  const input = document.getElementById("password");
  const eyeIcon = document.getElementById("eyeIcon");

  if(input.type === "password"){

    input.type = "text";

    eyeIcon.classList.remove("bi-eye-fill");
    eyeIcon.classList.add("bi-eye-slash-fill");

  }else{

    input.type = "password";

    eyeIcon.classList.remove("bi-eye-slash-fill");
    eyeIcon.classList.add("bi-eye-fill");

  }

}

/* MOBILE TOUCH IMPROVEMENT */

document.querySelectorAll("button, a, .toggle-password").forEach(el => {

  el.addEventListener("touchstart", () => {}, {
    passive:true
  });

});

</script>

</body>
</html>