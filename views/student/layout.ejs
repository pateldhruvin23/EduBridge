<!DOCTYPE html>
<html>
<head>

  <title>Student Panel</title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
    rel="stylesheet"
  >

  <!-- Google Font -->
  <link
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
  >


<!-- TweenMax REQUIRED -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/2.1.3/TweenMax.min.js"></script>


<script src="https://cdn.jsdelivr.net/gh/zarocknz/javascript-winwheel@master/Winwheel.min.js"></script>
<!-- GSAP -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>

<!-- Confetti -->
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    body{
      background:#f8fafc;
      font-family:'Poppins',sans-serif;
      overflow-x:hidden;
    }

    /* =========================
       SIDEBAR
    ========================= */

    .sidebar{
      width:260px;
      height:100vh;
      position:fixed;
      left:0;
      top:0;
      background:linear-gradient(
        180deg,
        #0f172a,
        #111827
      );
      padding:25px 18px;
      z-index:1000;
      overflow-y:auto;
    }

    .logo{
      color:white;
      font-size:26px;
      font-weight:700;
      text-align:center;
      margin-bottom:35px;
    }

    .sidebar-menu{
      display:flex;
      flex-direction:column;
      gap:8px;
    }

    .sidebar-menu a{
      color:#cbd5e1;
      text-decoration:none;
      padding:14px 16px;
      border-radius:14px;
      transition:0.3s;
      display:flex;
      align-items:center;
      gap:12px;
      font-weight:500;
      font-size:15px;
    }

    .sidebar-menu a:hover{
      background:#1e293b;
      color:white;
      transform:translateX(4px);
    }

    .sidebar-menu a.active{
      background:#2563eb;
      color:white;
      box-shadow:0 10px 20px rgba(37,99,235,0.3);
    }

    /* =========================
       MAIN
    ========================= */

    .main{
      margin-left:260px;
      min-height:100vh;
      display:flex;
      flex-direction:column;
    }

    /* =========================
       TOPBAR
    ========================= */

    .topbar{
      background:white;
      padding:18px 28px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      box-shadow:0 5px 20px rgba(0,0,0,0.05);
      position:sticky;
      top:0;
      z-index:500;
    }

    .topbar-left h4{
      margin:0;
      font-weight:700;
      color:#0f172a;
    }

    .topbar-left p{
      margin:0;
      color:#64748b;
      font-size:14px;
    }

    .topbar-right{
      display:flex;
      align-items:center;
      gap:15px;
    }

    .user-box{
      display:flex;
      align-items:center;
      gap:10px;
      background:#f1f5f9;
      padding:8px 14px;
      border-radius:14px;
    }

    .avatar{
      width:42px;
      height:42px;
      border-radius:50%;
      background:#2563eb;
      color:white;
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:700;
      font-size:18px;
    }

    /* =========================
       CONTENT
    ========================= */

    .content{
      flex:1;
      padding:30px;
    }

    /* =========================
       FOOTER
    ========================= */

    .footer{
  background:white;
  border-top:1px solid #e2e8f0;
  padding:22px 30px;
  margin-top:auto;
}

.footer-container{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}

.footer-left h6{
  margin:0;
  font-weight:700;
  color:#0f172a;
}

.footer-left p{
  margin:4px 0 0;
  color:#64748b;
  font-size:14px;
}





@media(max-width:768px){

  .footer-container{
    flex-direction:column;
    text-align:center;
  }

}

    /* =========================
       MOBILE
    ========================= */

    .mobile-toggle{
      display:none;
      font-size:24px;
      cursor:pointer;
    }

    @media(max-width:768px){

      .sidebar{
        left:-260px;
        transition:0.3s;
      }

      .sidebar.show{
        left:0;
      }

      .main{
        margin-left:0;
      }

      .mobile-toggle{
        display:block;
      }

      .topbar{
        padding:15px;
      }

      .content{
        padding:20px;
      }

    }

  </style>

</head>

<body>

<!-- =========================
     SIDEBAR
========================= -->

<div class="sidebar" id="sidebar">

  <div class="logo">
    🎓 EduBridge
  </div>

  <div class="sidebar-menu">

    <a href="/courses" >
      <i class="bi bi-book-fill"></i>
      Courses
    </a>

    <!--
    <a href="/reels">
      <i class="bi bi-play-circle-fill"></i>
      Reels
    </a>
    -->

    <a href="/account">
      <i class="bi bi-person-circle"></i>
      My Account
    </a>

    <a href="/logout">
      <i class="bi bi-box-arrow-right"></i>
      Logout
    </a>

  </div>

</div>

<!-- =========================
     MAIN
========================= -->

<div class="main">

  <!-- TOPBAR -->

  <div class="topbar">

    <div class="topbar-left d-flex align-items-center gap-3">

      <div
        class="mobile-toggle"
        onclick="toggleSidebar()"
      >
        <i class="bi bi-list"></i>
      </div>

      <div>
        <h4>Student Panel</h4>

        <p>
          Welcome back,
         <%= typeof user !== "undefined" && user
? user.name
: "Student" %>
        </p>
      </div>

    </div>

    <div class="topbar-right">

      <div class="user-box">

        <div class="avatar">
      <%= typeof user !== "undefined" && user
? user.name.charAt(0).toUpperCase()
: "U" %>
        </div>

        <div>

          <div class="fw-semibold">
          <%= typeof user !== "undefined" && user
? user.name
: "User" %>
          </div>

          <small class="text-muted">
            Student
          </small>

        </div>

      </div>

    </div>

  </div>

  <!-- CONTENT -->

  <div class="content">

    <%- body %>

  </div>

  <!-- FOOTER -->

<!-- FOOTER -->

<footer
  style="
    background:#0f172a;
    color:white;
    margin-top:60px;
    padding:40px 20px 20px;
  "
>

  <div class="container">

    <div class="row g-4">

      <!-- BRAND -->
      <div class="col-lg-4">

        <h4 class="fw-bold mb-3">
          🎓 EduBridge
        </h4>

        <p style="color:#cbd5e1; line-height:1.8;">

          EduBridge is a modern learning platform
          focused on accessible, practical,
          and student-friendly education.

        </p>

      </div>

      <!-- QUICK LINKS -->
      <div class="col-lg-4">

        <h5 class="fw-semibold mb-3">
          Quick Links
        </h5>

        <div class="d-flex flex-column gap-2">

          <a
            href="/page/about"
            class="footer-link"
          >
            About Us
          </a>

          <a
            href="/page/privacy-policy"
            class="footer-link"
          >
            Privacy Policy
          </a>

          <a
            href="/page/terms"
            class="footer-link"
          >
            Terms & Conditions
          </a>

          <a
            href="/page/contact"
            class="footer-link"
          >
            Contact Us
          </a>

        </div>

      </div>

      <!-- LEGAL -->
      <div class="col-lg-4">

        <h5 class="fw-semibold mb-3">
          Important Notice
        </h5>

        <p
          style="
            color:#cbd5e1;
            line-height:1.8;
            font-size:14px;
          "
        >

          By using EduBridge,
          you agree to our
          Privacy Policy and
          Terms & Conditions.

        </p>

      </div>

    </div>

    <hr
      style="
        border-color:rgba(255,255,255,0.1);
        margin:30px 0 20px;
      "
    >

    <div
      class="d-flex flex-column flex-md-row
      justify-content-between align-items-center"
    >

      <div style="color:#94a3b8;">

        © 2026 EduBridge.
        All rights reserved.

      </div>

      <div
        class="mt-3 mt-md-0"
        style="color:#94a3b8;"
      >

        Made with ❤️ for students

      </div>

    </div>

  </div>

</footer>

</div>

<script>

function toggleSidebar(){

  document
    .getElementById("sidebar")
    .classList
    .toggle("show");

}

</script>
<!-- DAILY SPIN MODAL -->

<% if(typeof showSpinWheel !== "undefined" && showSpinWheel){ %>

<div
  class="modal fade show"
  id="spinModal"
  style="
    display:block;
    background:rgba(0,0,0,0.7);
    backdrop-filter:blur(8px);
  "
>

  <div class="modal-dialog modal-dialog-centered">

    <div
      class="modal-content"
      style="
        background:#0f172a;
        border:1px solid rgba(255,255,255,0.1);
        border-radius:24px;
        overflow:hidden;
        color:white;
      "
    >

      <div class="modal-body text-center p-5">

        <div
          style="
            width:90px;
            height:90px;
            margin:auto;
            border-radius:24px;
            background:linear-gradient(135deg,#2563eb,#7c3aed);
            display:flex;
            justify-content:center;
            align-items:center;
            font-size:42px;
            margin-bottom:25px;
            box-shadow:0 10px 25px rgba(37,99,235,0.4);
          "
        >
          🎡
        </div>

        <h2
          style="
            font-weight:700;
            margin-bottom:15px;
          "
        >
          Daily Reward Available
        </h2>

        <p
          style="
            color:#cbd5e1;
            line-height:1.8;
          "
        >
          Spin the reward wheel and
          unlock free XP, premium rewards,
          bonus quizzes and more.
        </p>

        <a
          href="/spin-wheel"
          class="btn btn-primary w-100 mt-4"
          style="
            height:52px;
            border:none;
            border-radius:14px;
            background:linear-gradient(135deg,#2563eb,#7c3aed);
            font-weight:600;
            display:flex;
            align-items:center;
            justify-content:center;
          "
        >
          Open Spin Wheel
        </a>

      </div>

    </div>

  </div>

</div>

<% } %>

</body>
</html>