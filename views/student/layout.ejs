<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0"
/>

<meta
  name="google-site-verification"
  content="c3yDZqD0SPEwnA2G6IhpoR-BFenjk0dXavfjPU5TUcM"
/>

<title>
  EduBridge - Online Learning Platform by Dhruvin Patel
</title>

<meta
  name="description"
  content="EduBridge is an online learning platform created by Dhruvin Patel. Learn through courses, quizzes, notes, reels, rewards and skill development."
/>

<meta
  name="keywords"
  content="EduBridge, Edu Bridge, Dhruvin Patel, DS Office, Online Learning Platform, Education, Courses, Student Learning"
/>

<meta
  name="author"
  content="Dhruvin Patel"
/>

<meta
  property="og:title"
  content="EduBridge - Online Learning Platform"
/>

<meta
  property="og:description"
  content="Learn through courses, quizzes, notes and rewards."
/>

<meta
  property="og:type"
  content="website"
/>

<meta
  property="og:url"
  content="https://edu-bridge-ds.vercel.app"
/>

<meta
  name="robots"
  content="index, follow"
/>

</head>

<body>

<div class="app">

  <!-- OVERLAY -->

  <div
    class="sidebar-overlay"
    id="sidebarOverlay"
  ></div>

  <!-- SIDEBAR -->

<!-- SIDEBAR -->

<aside
  class="sidebar"
  id="sidebar"
>

  <div class="logo-box">

    <div class="logo-icon">
      🎓
    </div>

    <div class="logo">
      EduBridge
    </div>

    <div class="logo-subtitle">
      Smart Learning Platform
    </div>

  </div>

  <!-- MAIN MENU -->

  <div class="sidebar-menu">

    <a href="/courses" class="">
      <i class="bi bi-book-fill"></i>
      Courses
    </a>

    <a href="/account">
      <i class="bi bi-person-circle"></i>
      My Account
    </a>

    <a href="/logout">
      <i class="bi bi-box-arrow-right"></i>
      Logout
    </a>

  </div>

  <!-- MOBILE ONLY EXTRA LINKS -->

  <div class="mobile-sidebar-links">

    <div class="sidebar-divider"></div>

    <div class="sidebar-title">
      INFORMATION
    </div>

    <div class="sidebar-menu">

      <a href="/page/about">
        <i class="bi bi-info-circle-fill"></i>
        About Us
      </a>

      <a href="/page/privacy-policy">
        <i class="bi bi-shield-check"></i>
        Privacy Policy
      </a>

      <a href="/page/terms">
        <i class="bi bi-file-earmark-text-fill"></i>
        Terms
      </a>

      <a href="/page/contact">
        <i class="bi bi-envelope-fill"></i>
        Contact
      </a>

    </div>

  </div>

</aside>

  <!-- MAIN -->

  <main class="main">

    <!-- TOPBAR -->

    <div class="topbar">

      <!-- LEFT -->

      <div class="topbar-left">

        <!-- MOBILE MENU -->

        <div
          class="mobile-toggle"
          id="menuBtn"
        >
          <i class="bi bi-list"></i>
        </div>

        <!-- WELCOME -->

        <div class="welcome-box">

          <!-- DESKTOP ONLY -->

          <div class="welcome-badge">
            🎓 EduBridge
          </div>

          <h4>
            Student Panel
          </h4>

          <p>
            Welcome back,
            <span class="welcome-name">

              <%= typeof user !== "undefined" && user
              ? user.name
              : "Student" %>

            </span>
          </p>

        </div>

      </div>

      <!-- RIGHT -->

      <div class="topbar-right">

        <!-- DESKTOP XP -->

        <div class="xp-box">

          <div class="xp-icon">
            <i class="bi bi-stars"></i>
          </div>

          <div>

            <div class="xp-label">
              XP Points
            </div>

            <div class="xp-value">

              <%= typeof user !== "undefined" && user
              ? (user.xp || 0)
              : 0 %>

            </div>

          </div>

        </div>

        <!-- DESKTOP USER -->

        <div class="user-box">

          <div class="avatar">

            <%= typeof user !== "undefined" && user
            ? user.name.charAt(0).toUpperCase()
            : "U" %>

          </div>

          <div>

            <div class="user-name">

              <%= typeof user !== "undefined" && user
              ? user.name
              : "User" %>

            </div>

            <div class="user-role">
              Student
            </div>

          </div>

        </div>

        <!-- MOBILE USER -->

        <div class="mobile-user-wrapper">

          <div
            class="user-avatar-btn"
            id="userToggle"
          >

            <%= typeof user !== "undefined" && user
            ? user.name.charAt(0).toUpperCase()
            : "U" %>

          </div>

          <div
            class="mobile-user-dropdown"
            id="userDropdown"
          >

            <div class="dropdown-user-name">

              <%= typeof user !== "undefined" && user
              ? user.name
              : "User" %>

            </div>

            <div class="dropdown-user-role">
              Student
            </div>

          </div>

        </div>

      </div>

    </div>

    <!-- CONTENT -->

    <div class="content">

      <%- body %>

    </div>

    <!-- FOOTER -->

    <footer class="footer">

      <div class="container">

        <div class="row g-4">

          <div class="col-lg-4">

            <h4 class="fw-bold mb-3">
              🎓 EduBridge
            </h4>

            <p style="color:#cbd5e1;line-height:1.8;">

              EduBridge is a modern learning platform focused on accessible education.

            </p>

          </div>

          <div class="col-lg-4">

            <h5 class="fw-semibold mb-3">
              Quick Links
            </h5>

            <div class="d-flex flex-column gap-2">

              <a href="/page/about" class="footer-link">
                About Us
              </a>

              <a href="/page/privacy-policy" class="footer-link">
                Privacy Policy
              </a>

              <a href="/page/terms" class="footer-link">
                Terms
              </a>

              <a href="/page/contact" class="footer-link">
                Contact
              </a>

            </div>

          </div>

          <div class="col-lg-4">

            <h5 class="fw-semibold mb-3">
              Notice
            </h5>

            <p style="color:#cbd5e1;line-height:1.8;font-size:14px;">

              By using EduBridge, you agree to our policies and terms.

            </p>

          </div>

        </div>

      </div>

    </footer>

  </main>

</div>

<!-- SCRIPT -->

<script>

const sidebar =
  document.getElementById("sidebar");

const overlay =
  document.getElementById("sidebarOverlay");

const menuBtn =
  document.getElementById("menuBtn");

/* OPEN */

function openSidebar(){

  sidebar.classList.add("show");

  overlay.classList.add("show");

}

/* CLOSE */

function closeSidebar(){

  sidebar.classList.remove("show");

  overlay.classList.remove("show");

}

/* TOGGLE */

function toggleSidebar(){

  sidebar.classList.toggle("show");

  overlay.classList.toggle("show");

}

/* MENU BUTTON */

if(menuBtn){

  menuBtn.addEventListener(
    "click",
    toggleSidebar
  );

}

/* CLICK OUTSIDE */

overlay.addEventListener(
  "click",
  closeSidebar
);

/* AUTO CLOSE */

document
  .querySelectorAll(".sidebar a")
  .forEach(link => {

    link.addEventListener(
      "click",
      () => {

        if(window.innerWidth < 992){
          closeSidebar();
        }

      }
    );

  });

/* MOBILE USER DROPDOWN */

const userToggle =
  document.getElementById("userToggle");

const userDropdown =
  document.getElementById("userDropdown");

if(userToggle){

  userToggle.addEventListener(
    "click",
    () => {

      userDropdown.classList.toggle("show");

    }
  );

  document.addEventListener(
    "click",
    e => {

      if(
        !userToggle.contains(e.target) &&
        !userDropdown.contains(e.target)
      ){

        userDropdown.classList.remove("show");

      }

    }
  );

}

</script>

</body>
</html>