<% if(!user){ %>

<!DOCTYPE html>
<html>
<head>
 <meta charset="UTF-8">

 <meta name="google-site-verification" content="c3yDZqD0SPEwnA2G6IhpoR-BFenjk0dXavfjPU5TUcM" />
  <title><%= page.title %></title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <style>

    body{
      background:#0f172a;
      color:white;
      font-family:sans-serif;
    }

    .page-box{
      max-width:900px;
      margin:auto;
      padding:50px 20px;
    }

    .top-actions{
      display:flex;
      gap:15px;
      margin-bottom:30px;
    }

    .content-box{
      background:#1e293b;
      padding:35px;
      border-radius:20px;
      line-height:1.9;
    }

  </style>

</head>

<body>

<div class="page-box">

  <div class="top-actions">

    <a
      href="/signup"
      class="btn btn-primary"
    >
      Create Account
    </a>

    <a
      href="/login"
      class="btn btn-outline-light"
    >
      Login
    </a>

  </div>

  <div class="content-box">

    <%- page.html %>

  </div>

</div>

</body>
</html>

<% } else { %>

<div class="container py-4">

  <div
    class="bg-white p-4 rounded shadow-sm"
  >

    <%- page.html %>

  </div>

</div>

<% } %>