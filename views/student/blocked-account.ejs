<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>Account Restricted</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Bootstrap Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html{
      height:100%;
    }

    body{
      min-height:100dvh;

      display:flex;
      justify-content:center;
      align-items:center;

      background:linear-gradient(
        135deg,
        #0f172a,
        #1e293b,
        #334155
      );

      font-family:"Segoe UI",sans-serif;

      overflow:hidden;

      position:relative;

      padding:16px;
    }

    /* SAFE AREA */

    @supports(padding:max(0px)){

      body{
        padding-top:max(16px, env(safe-area-inset-top));
        padding-bottom:max(16px, env(safe-area-inset-bottom));
        padding-left:max(16px, env(safe-area-inset-left));
        padding-right:max(16px, env(safe-area-inset-right));
      }

    }

    /* GLOW */

    body::before{
      content:"";

      position:absolute;

      width:500px;
      height:500px;

      background:#ef4444;

      border-radius:50%;

      top:-220px;
      left:-180px;

      filter:blur(120px);

      opacity:0.32;
    }

    body::after{
      content:"";

      position:absolute;

      width:420px;
      height:420px;

      background:#7c3aed;

      border-radius:50%;

      bottom:-220px;
      right:-160px;

      filter:blur(120px);

      opacity:0.18;
    }

    /* CARD */

    .block-card{
      width:100%;
      max-width:480px;

      background:rgba(255,255,255,0.08);

      backdrop-filter:blur(20px);
      -webkit-backdrop-filter:blur(20px);

      border:1px solid rgba(255,255,255,0.12);

      border-radius:32px;

      padding:42px 30px;

      text-align:center;

      color:white;

      box-shadow:
        0 10px 40px rgba(0,0,0,0.25);

      position:relative;
      z-index:10;

      overflow:hidden;
    }

    /* ICON */

    .icon-box{
      width:95px;
      height:95px;

      margin:auto;

      border-radius:28px;

      background:linear-gradient(
        135deg,
        #dc2626,
        #ef4444
      );

      display:flex;
      align-items:center;
      justify-content:center;

      font-size:42px;

      box-shadow:
        0 12px 30px rgba(239,68,68,0.4);
    }

    /* TITLE */

    .title{
      font-size:32px;
      font-weight:800;
      margin-top:28px;
      line-height:1.3;
    }

    /* TEXT */

    .subtitle{
      color:#cbd5e1;

      font-size:15px;

      line-height:1.8;

      margin-top:18px;
    }

    /* BUTTON */

    .btn-modern{
      height:58px;

      border:none;

      border-radius:18px;

      font-weight:700;

      font-size:16px;

      background:linear-gradient(
        135deg,
        #dc2626,
        #ef4444
      );

      transition:0.3s;

      display:flex;
      align-items:center;
      justify-content:center;

      touch-action:manipulation;
    }

    .btn-modern:hover{
      transform:translateY(-2px);

      box-shadow:
        0 12px 25px rgba(239,68,68,0.35);
    }

    .btn-modern:active{
      transform:scale(0.98);
    }

    /* MOBILE */

    @media(max-width:768px){

      body{
        padding:14px;
      }

      .block-card{
        border-radius:28px;
        padding:36px 24px;
      }

      .title{
        font-size:28px;
      }

    }

    /* SMALL MOBILE */

    @media(max-width:480px){

      body{
        padding:12px;
      }

      .block-card{
        padding:30px 20px;
        border-radius:24px;
      }

      .icon-box{
        width:82px;
        height:82px;
        border-radius:24px;
        font-size:36px;
      }

      .title{
        font-size:24px;
        margin-top:22px;
      }

      .subtitle{
        font-size:14px;
      }

      .btn-modern{
        height:54px;
        font-size:15px;
      }

    }

  </style>

</head>

<body>

<div class="block-card">

  <div class="icon-box">
    <i class="bi bi-shield-lock-fill"></i>
  </div>

  <h2 class="title">
    Account Restricted
  </h2>

  <p class="subtitle">
    Your account has been temporarily restricted by the administrator.
    <br><br>
    If you believe this was done by mistake, you can request a review.
  </p>

  <a
    href="/unblock-request"
    class="btn btn-danger w-100 btn-modern mt-4"
  >
    Request Account Review
  </a>

</div>

<script>

/* TOUCH SUPPORT */

document.querySelectorAll(
  "button, a"
).forEach(el => {

  el.addEventListener(
    "touchstart",
    () => {},
    { passive:true }
  );

});

</script>

</body>
</html>