<style>
.video-card { background:#1e293b; border-radius:12px; }
.video-item {
  background:#1e293b;
  border-radius:8px;
  cursor:pointer;
  transition:0.2s;
  color:white;
}
.video-item:hover { background:#334155; }
.video-item.active { background:#2563eb; }
.video-thumb { width:80px; border-radius:6px; }
.notes-card { background:#1e293b; border-radius:10px; }

.toast-box {
  position: fixed;
  top: 20px;
  right: -300px;
  padding: 12px 18px;
  border-radius: 8px;
  color: white;
  font-weight: 500;
  transition: 0.3s;
  z-index: 9999;
}
.toast-box.show { right: 20px; }
.toast-box.success { background: #22c55e; }
.toast-box.error { background: #ef4444; }
.toast-box.warning { background: #f59e0b; }

.youtube-frame{
  width:100%;
  height:100%;
  border:none;
  border-radius:12px;
}

.playlist-item:hover{
  background:#334155 !important;
  transform:translateY(-2px);
}

.playlist-active{
  border:1px solid #2563eb !important;
  background:#1d4ed8 !important;
  box-shadow:0 10px 25px rgba(37,99,235,0.25);
}

.playlist-locked{
  opacity:0.5;
  cursor:not-allowed !important;
}

.playlist-card::-webkit-scrollbar{
  width:6px;
}

.playlist-card::-webkit-scrollbar-thumb{
  background:#334155;
  border-radius:20px;
}

/* =========================
   QUIZ UI
========================= */

.quiz-card{
  background:#0f172a;
  border-radius:18px;
  overflow:hidden;
  border:1px solid rgba(255,255,255,0.06);
}

.quiz-header{
  padding:18px 22px;
  background:linear-gradient(
    135deg,
    #2563eb,
    #1d4ed8
  );
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.quiz-title{
  font-size:18px;
  font-weight:700;
  color:white;
}

.quiz-timer{
  font-weight:600;
  color:white;
}

.quiz-body{
  padding:24px;
}

.quiz-question{
  color:white;
  font-size:18px;
  font-weight:600;
  margin-bottom:22px;
}

.quiz-option{
  width:100%;
  border:none;
  border-radius:14px;
  padding:14px 18px;
  margin-bottom:12px;
  background:#1e293b;
  color:white;
  text-align:left;
  transition:0.25s;
  font-weight:500;
}

.quiz-option:hover{
  background:#334155;
  transform:translateX(3px);
}

.quiz-option.correct{
  background:#16a34a !important;
}

.quiz-option.wrong{
  background:#dc2626 !important;
}

.quiz-status{
  margin-top:18px;
  font-weight:600;
  color:white;
}

.quiz-progress{
  height:8px;
  background:#1e293b;
  overflow:hidden;
}

.quiz-progress-bar{
  height:100%;
  width:100%;
  background:#22c55e;
  transition:1s linear;
}

.code-editor{
  background:#020617;
  color:#38bdf8;
  border:none;
  border-radius:16px;
  padding:18px;
  font-family:monospace;
  min-height:220px;
  resize:none;
}

.retry-box{
  background:#7c2d12;
  color:white;
  padding:12px;
  border-radius:12px;
  margin-top:15px;
}


</style>

<h4 class="fw-bold mb-3">🎬 <%= course.title %></h4>

<div class="row g-4 align-items-start">

<!-- VIDEO -->
<div class="col-lg-8">

  <div class="video-card p-2 mb-3">
    <div class="ratio ratio-16x9">
<iframe
  id="player"
  class="youtube-frame"
  src="https://www.youtube.com/embed/<%= startVideo.youtube_video_id %>?enablejsapi=1&playsinline=0&rel=0&modestbranding=1&controls=1&fs=1&iv_load_policy=3&cc_load_policy=0"
  title="YouTube video player"
  frameborder="0"
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
  allowfullscreen>
</iframe>
    </div>
  </div>

  <button onclick="markComplete()" class="btn btn-success w-100 mb-3">
    ✔ Mark Completed
  </button>

  <!-- QUIZ -->
<div id="quizSection" style="display:none;" class="mb-3">

  <div class="quiz-card">

    <div class="quiz-header">

      <div class="quiz-title">
        🧠 Lesson Quiz
      </div>

      <div class="quiz-timer" id="quizTimer">
        60s
