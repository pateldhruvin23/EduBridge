<script src="https://www.youtube.com/iframe_api"></script>

<script>
  let currentQuizIndex = 0;
let currentQuizQuestions = [];
let quizScore = 0;
let videos = <%- JSON.stringify(videos) %>;
let quizzes = <%- JSON.stringify(quizzes) %>;
let passedMap = <%- JSON.stringify(passedMap) %>;

let currentVideoId = <%= startVideo.id %>;
let currentVideoIndex = videos.findIndex(v => v.id === currentVideoId);

let player;
let timerInterval;
let retryTimeout = false;

// INIT PLAYER
function onYouTubeIframeAPIReady() {
player = new YT.Player('player', {
  playerVars: {
    rel: 0,
    modestbranding: 1,
    controls: 1,
    fs: 1,
    iv_load_policy: 3,
    cc_load_policy: 0
  },
  events: {
    'onStateChange': onPlayerStateChange
  }
});
}

// AUTO NEXT
function onPlayerStateChange(event) {
  if (event.data === YT.PlayerState.ENDED) {
    playNextVideo();
  }
}

// NEXT VIDEO
function playNextVideo() {
  let nextIndex = currentVideoIndex + 1;

  if (nextIndex < videos.length) {

    const prevVideo = videos[currentVideoIndex];

// CHECK QUIZ EXISTS
const hasQuiz = quizzes.some(
  q => q.video_id === prevVideo.id
);

// ONLY BLOCK IF QUIZ EXISTS
if(hasQuiz && !passedMap[prevVideo.id]){

  showToast(
    "Complete quiz first",
    "warning"
  );

  return;
}

    const nextVideo = videos[nextIndex];

    currentVideoIndex = nextIndex;
    currentVideoId = nextVideo.id;

    player.loadVideoById(nextVideo.youtube_video_id);

    updateActive(nextVideo.id);
    loadQuiz(nextVideo.id);
  }
}

// PLAY VIDEO
function playVideo(videoId, dbId) {
  player.loadVideoById(videoId);

  currentVideoId = dbId;
  currentVideoIndex = videos.findIndex(v => v.id === dbId);

  updateActive(dbId);
  loadQuiz(dbId);
}

// ACTIVE UI
function updateActive(id){

  // REMOVE OLD ACTIVE
  document
    .querySelectorAll(".playlist-item")
    .forEach(el => {

      el.classList.remove(
        "playlist-active"
      );

    });

  // ADD NEW ACTIVE
  const activeVideo =
    document.getElementById("video-" + id);

  if(activeVideo){

    activeVideo.classList.add(
      "playlist-active"
    );

  }

}


// LOAD QUIZ
async function loadQuiz(videoId){

  clearInterval(timerInterval);

  const container =
    document.getElementById("quizContainer");

  const section =
    document.getElementById("quizSection");

  const status =
    document.getElementById("quizStatus");

  const timerEl =
    document.getElementById("quizTimer");

  const progressBar =
    document.getElementById("quizProgressBar");

  container.innerHTML = "";
  status.innerHTML = "";

  currentQuizQuestions =
    quizzes.filter(q => q.video_id === videoId);

  currentQuizIndex = 0;
  quizScore = 0;

  if(currentQuizQuestions.length === 0){

    section.style.display = "none";

    return;
  }

  section.style.display = "block";

  renderQuestion();

  // TIMER
  let totalTime = 60 * currentQuizQuestions.length;
  let time = totalTime;

  timerEl.innerText = `${time}s`;

  timerInterval = setInterval(() => {

    time--;

    timerEl.innerText = `${time}s`;

    progressBar.style.width =
      (time / totalTime) * 100 + "%";

    if(time <= 0){

      clearInterval(timerInterval);

      finishQuiz(videoId);

    }

  },1000);
}
function renderQuestion(){

  const container =
    document.getElementById("quizContainer");

  const q =
    currentQuizQuestions[currentQuizIndex];

  if(!q){
    return;
  }

  // =========================
  // MCQ TYPE
  // =========================

  if(!q.type || q.type === "mcq"){

    container.innerHTML = `

      <div class="quiz-question">
        Question ${currentQuizIndex + 1}
        of ${currentQuizQuestions.length}
        <br><br>
        ${q.question}
      </div>

      ${[
        q.option_a,
        q.option_b,
        q.option_c,
        q.option_d
      ]
      .filter(Boolean)
      .map(opt => `

        <button
          class="quiz-option"
          onclick="answerQuestion(
            this,
            '${q.correct_answer}'
          )">

          ${opt}

        </button>

      `).join("")}

    `;

  }

  // =========================
  // CODE TYPE
  // =========================

  else if(
    q.type &&
    q.type.toLowerCase() === "code"
  ){

    container.innerHTML = `

      <div class="quiz-question">
        Question ${currentQuizIndex + 1}
        of ${currentQuizQuestions.length}
        <br><br>
        ${q.question}
      </div>

      <textarea
        id="codeInput"
        class="code-editor"
        placeholder="Write your code here..."
      >${q.starter_code || ""}</textarea>

      <button
        class="btn btn-primary w-100 mt-3"
        onclick="submitCodeQuestion(
          '${q.expected_output || ""}'
        )">

        ▶ Submit Code

      </button>

    `;
  }

  // =========================
  // TEXT TYPE
  // =========================

  else{

    container.innerHTML = `

      <div class="quiz-question">
        Question ${currentQuizIndex + 1}
        of ${currentQuizQuestions.length}
        <br><br>
        ${q.question}
      </div>

      <textarea
        id="textAnswer"
        class="form-control"
        rows="5"
        placeholder="Write your answer..."
        style="
          background:#1e293b;
          color:white;
          border:none;
          border-radius:14px;
        "
      ></textarea>

      <button
        class="btn btn-success w-100 mt-3"
        onclick="submitTextAnswer()">

        Submit Answer

      </button>

    `;
  }
}



  const q =
    currentQuizQuestions[currentQuizIndex];

  if(!q){
    return;
  }

  // =========================
  // MCQ TYPE
  // =========================

  if(!q.type || q.type === "mcq"){

    container.innerHTML = `

      <div class="quiz-question">
        Question ${currentQuizIndex + 1}
        of ${currentQuizQuestions.length}
        <br><br>
        ${q.question}
      </div>

      ${[
        q.option_a,
        q.option_b,
        q.option_c,
        q.option_d
      ]
      .filter(Boolean)
      .map(opt => `

        <button
          class="quiz-option"
          onclick="answerQuestion(
            this,
            '${q.correct_answer}'
          )">

          ${opt}

        </button>

      `).join("")} 

    `;

  }

  // =========================
  // CODE TYPE
  // =========================

else if(q.type && q.type.toLowerCase() === "code"){

    container.innerHTML = `

      <div class="quiz-question">
        Question ${currentQuizIndex + 1}
        of ${currentQuizQuestions.length}
        <br><br>
        ${q.question}
      </div>

      <textarea
        id="codeInput"
        class="code-editor"
        placeholder="Write your code here..."
      >${q.starter_code || ""}</textarea>

      <button
        class="btn btn-primary w-100 mt-3"
        onclick="submitCodeQuestion(
          '${q.expected_output || ""}'
        )">

        ▶ Submit Code

      </button>

    `;
  }

  // =========================
  // NORMAL TEXT TYPE
  // =========================

  else{

    container.innerHTML = `

      <div class="quiz-question">
        Question ${currentQuizIndex + 1}
        of ${currentQuizQuestions.length}
        <br><br>
        ${q.question}
      </div>

      <textarea
        id="textAnswer"
        class="form-control"
        rows="5"
        placeholder="Write your answer..."
        style="
          background:#1e293b;
          color:white;
          border:none;
          border-radius:14px;
        "
      ></textarea>

      <button
        class="btn btn-success w-100 mt-3"
        onclick="submitTextAnswer()">

        Submit Answer

      </button>

    `;
  }
}

function submitCodeQuestion(expected){

  const code =
    document.getElementById("codeInput")
    .value
    .trim();

  const isCorrect =
    code.includes(expected);

  if(isCorrect){

    quizScore++;

    showToast(
      "Correct Code!",
      "success"
    );

  }else{

    showToast(
      "Wrong Code Output",
      "error"
    );
  }

  nextQuestion();
}

function submitTextAnswer(){

  const answer =
    document.getElementById("textAnswer")
    .value
    .trim();

  if(answer.length < 3){

    showToast(
      "Write proper answer",
      "warning"
    );

    return;
  }

  // OPTIONAL:
  // you can validate with AI later

  quizScore++;

  showToast(
    "Answer Submitted",
    "success"
  );

  nextQuestion();
}

function nextQuestion(){

  setTimeout(() => {

    currentQuizIndex++;

    if(
      currentQuizIndex <
      currentQuizQuestions.length
    ){

      renderQuestion();

    }else{

      finishQuiz(currentVideoId);

    }

  },1200);
}

document.getElementById("quizContainer");

function answerQuestion(btn, correctAnswer){

  const selected =
    btn.innerText.trim();

  const buttons =
    document.querySelectorAll(".quiz-option");

  buttons.forEach(b => {

    b.disabled = true;

    if(
      b.innerText.trim() === correctAnswer
    ){
      b.classList.add("correct");
    }
  });

  if(selected === correctAnswer){

    quizScore++;

    btn.classList.add("correct");

  }else{

    btn.classList.add("wrong");
  }

  setTimeout(() => {

    currentQuizIndex++;

    if(
      currentQuizIndex <
      currentQuizQuestions.length
    ){

      renderQuestion();

    }else{

      finishQuiz(currentVideoId);

    }

  },1200);
}

async function finishQuiz(videoId){

  clearInterval(timerInterval);

  const status =
    document.getElementById("quizStatus");

  const total =
    currentQuizQuestions.length;

  const percentage =
    Math.round((quizScore / total) * 100);

  const passed =
    percentage >= 50;

  // SAVE
  await fetch("/submit-quiz", {

    method:"POST",

    headers:{
      "Content-Type":"application/json"
    },

    body:JSON.stringify({
      videoId,
      correct: passed
    })

  });

  if(passed){

    passedMap[videoId] = true;

    status.innerHTML = `
      <div class="alert alert-success">

        ✅ Quiz Passed

        <hr>

        Score:
        ${quizScore}/${total}

        (${percentage}%)

      </div>
    `;

    showToast(
      "Quiz Passed!",
      "success"
    );

    setTimeout(() => {

      playNextVideo();

    },2000);

  }else{

    status.innerHTML = `
      <div class="alert alert-danger">

        ❌ Quiz Failed

        <hr>

        Score:
        ${quizScore}/${total}

        (${percentage}%)

      </div>

      <button
        class="btn btn-warning mt-3"
        onclick="loadQuiz(${videoId})">

        Retry Quiz

      </button>
    `;

    showToast(
      "Quiz Failed",
      "error"
    );
  }
}





// TOAST
function showToast(message, type = "success") {
  const toast = document.createElement("div");
  toast.className = `toast-box ${type}`;
  toast.innerText = message;

  document.body.appendChild(toast);

  setTimeout(() => toast.classList.add("show"), 100);
  setTimeout(() => {
    toast.classList.remove("show");
    setTimeout(() => toast.remove(), 300);
  }, 3000);
}

// COMPLETE VIDEO
async function markComplete() {
  await fetch("/complete-video", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ videoId: currentVideoId })
  });

  showToast("Marked Complete", "success");
}

// INIT
loadQuiz(currentVideoId);
async function reportComment(commentId){

  const reason = prompt(
    "Enter reason for reporting this comment:"
  );

  if(!reason || reason.trim() === ""){
    showToast("Report cancelled","warning");
    return;
  }

  try{

    const res = await fetch("/report-comment", {
      method:"POST",
      headers:{
        "Content-Type":"application/json"
      },
      body:JSON.stringify({
        commentId,
        reason
      })
    });

    const data = await res.json();

    if(data.success){

      showToast(
        "Comment reported successfully",
        "warning"
      );

    }else{

      showToast(
        "Failed to report comment",
        "error"
      );

    }

  }catch(err){

    showToast(
      "Something went wrong",
      "error"
    );

  }
}
