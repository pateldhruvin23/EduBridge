      <% videos.forEach((v, index) => { %>

      <%
        const prevVideo = videos[index - 1];
        const prevHasQuiz = prevVideo
  ? quizzes.some(q => q.video_id === prevVideo.id)
  : false;

const prevPassed = prevVideo
  ? (!prevHasQuiz || passedMap[prevVideo.id])
  : true;
        const isUnlocked = index === 0 || prevPassed;

        const isCompleted = completedIds.includes(v.id);
        const isActive = v.id === startVideo.id;
      %>

      <div
        id="video-<%= v.id %>"

        class="playlist-item mb-3
        <%= isActive ? 'playlist-active' : '' %>
        <%= !isUnlocked ? 'playlist-locked' : '' %>"

        <% if (isUnlocked) { %>
          onclick="playVideo('<%= v.youtube_video_id %>', <%= v.id %>)"
        <% } %>

        style="
          background:#1e293b;
          border-radius:18px;
          padding:12px;
          cursor:pointer;
          transition:0.25s;
          border:1px solid transparent;
        "
      >

        <div class="d-flex gap-3">

          <!-- THUMB -->
          <div style="position:relative;">

            <img
              src="<%= v.thumbnail || 'https://via.placeholder.com/120' %>"

              style="
                width:110px;
                height:70px;
                object-fit:cover;
                border-radius:12px;
              "
            >

            <!-- STATUS -->
            <div
              style="
                position:absolute;
                top:6px;
                right:6px;
              "
            >

              <% if (!isUnlocked) { %>

                <span class="badge bg-dark">
                  🔒
                </span>

              <% } else if (isCompleted) { %>

                <span class="badge bg-success">
                  ✔
                </span>

              <% } else { %>

                <span class="badge bg-primary">
                  ▶
                </span>

              <% } %>

            </div>

          </div>

          <!-- CONTENT -->
          <div class="flex-grow-1">

            <div
              class="text-white fw-semibold"
              style="
                line-height:1.5;
                font-size:15px;
              "
            >
              <%= v.title %>
            </div>

            <div
              class="small mt-2"
              style="color:#94a3b8;"
            >

              Lesson <%= index + 1 %>

              <% if (isCompleted) { %>

                • Completed

              <% } else if (!isUnlocked) { %>

                • Locked

              <% } else { %>

                • Ready to watch

              <% } %>

            </div>

          </div>

        </div>

      </div>

      <% }) %>

    </div>

  </div>

  <!-- NOTES CARD -->
  <div
    class="notes-card p-4 text-white"
