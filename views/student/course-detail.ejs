  "

  onmouseout="
    this.style.background='#1e293b';
    this.style.transform='translateY(0px)';
  "
>

  <div class="d-flex align-items-center gap-3">

    <div
      style="
        width:45px;
        height:45px;
        border-radius:12px;
        background:#2563eb;
