    </div>

  </div>

</div>

<!-- COMMENTS -->
<div class="notes-card p-4 mt-3">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-3">

    <h5 class="text-white mb-0 fw-bold">
      💬 Discussion & Doubts
    </h5>

    <span class="badge bg-primary rounded-pill">
      <%= comments.length %> Messages
    </span>

  </div>

  <!-- COMMENT FORM -->
  <form
    method="POST"
    action="/comment"
    class="mb-4"
  >

    <input
      type="hidden"
      name="courseId"
      value="<%= course.id %>"
    >

    <div class="d-flex gap-2">

      <!-- USER AVATAR -->
      <div
        class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
        style="width:45px;height:45px;min-width:45px;"
      >
        <%= user.name.charAt(0).toUpperCase() %>
      </div>

      <div class="flex-grow-1">

        <textarea
          class="form-control border-0 shadow-none"
          name="message"
          rows="2"
          placeholder="Ask your doubt or discuss lesson..."
          style="
            border-radius:14px;
            resize:none;
            background:#f8fafc;
          "
          required
        ></textarea>

        <div class="text-end mt-2">

          <button
            class="btn btn-primary px-4 rounded-pill"
          >
            <i class="bi bi-send-fill"></i>
            Send
          </button>

        </div>

      </div>

    </div>

  </form>

  <!-- COMMENTS LIST -->
  <div class="comment-list">

    <% if(comments.length === 0){ %>

      <div class="text-center text-light opacity-75 py-4">

        <i class="bi bi-chat-square-text fs-1"></i>

        <p class="mt-2 mb-0">
          No discussions yet
        </p>

      </div>

    <% } %>

    <% comments.forEach(c => { %>

      <div
        class="comment-item mb-3 p-3"
        style="
          background:#0f172a;
          border-radius:18px;
          border:1px solid rgba(255,255,255,0.06);
        "
      >

        <!-- TOP -->
        <div class="d-flex justify-content-between align-items-start">

          <div class="d-flex gap-3">

            <!-- AVATAR -->
            <div
              class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold"
              style="width:45px;height:45px;min-width:45px;"
            >
              <%= (c.user_name || "U").charAt(0).toUpperCase() %>
            </div>

            <!-- CONTENT -->
            <div>

              <div class="text-white fw-semibold">

                <%= c.user_name || "Student" %>

              </div>

              <div
                class="small text-light opacity-75 mb-2"
              >
                <i class="bi bi-clock"></i>

                <%= new Date(c.created_at).toLocaleString() %>
              </div>

              <div
                class="text-white"
                style="
                  line-height:1.6;
                  word-break:break-word;
                "
              >
                <%= c.message %>
              </div>

            </div>

          </div>

          <!-- REPORT -->
          <button
            class="btn btn-sm btn-outline-danger rounded-circle"
            onclick="reportComment(<%= c.id %>)"
            style="width:38px;height:38px;"
          >
            <i class="bi bi-flag"></i>
          </button>

        </div>

      </div>

    <% }) %>

  </div>

</div>
