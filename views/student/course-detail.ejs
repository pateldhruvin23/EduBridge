<style>

body{
  background:#f1f5f9;
  font-family:'Poppins',sans-serif;
}

/* =========================
   DESKTOP KEEP SAME
========================= */

.video-card{
  background:#1e293b;
  border-radius:18px;
}

.video-item{
  background:#1e293b;
  border-radius:8px;
  cursor:pointer;
  transition:0.2s;
  color:white;
}

.video-item:hover{
  background:#334155;
}

.video-item.active{
  background:#2563eb;
}

.video-thumb{
  width:80px;
  border-radius:6px;
}

.notes-card{
  background:#1e293b;
  border-radius:22px;
}

.toast-box{
  position:fixed;
  top:20px;
  right:-300px;
  padding:12px 18px;
  border-radius:10px;
  color:white;
  font-weight:500;
  transition:0.3s;
  z-index:9999;
}

.toast-box.show{
  right:20px;
}

.toast-box.success{
  background:#22c55e;
}

.toast-box.error{
  background:#ef4444;
}

.toast-box.warning{
  background:#f59e0b;
}

.youtube-frame{
  width:100%;
  height:100%;
  border:none;
  border-radius:18px;
}

.playlist-item:hover{
  background:#334155 !important;
  transform:translateY(-2px);
}

.playlist-active{
  border:1px solid #2563eb !important;
  background:#1d4ed8 !important;
  box-shadow:0 10px 25px rgba(37,99,235,0.25);
}

.playlist-locked{
  opacity:0.5;
  cursor:not-allowed !important;
}

.playlist-card::-webkit-scrollbar{
  width:6px;
}

.playlist-card::-webkit-scrollbar-thumb{
  background:#334155;
  border-radius:20px;
}

/* =========================
   QUIZ UI
========================= */

.quiz-card{
  background:#0f172a;
  border-radius:22px;
  overflow:hidden;
  border:1px solid rgba(255,255,255,0.06);
}

.quiz-header{
  padding:18px 22px;
  background:linear-gradient(
    135deg,
    #2563eb,
    #1d4ed8
  );
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.quiz-title{
  font-size:18px;
  font-weight:700;
  color:white;
}

.quiz-timer{
  font-weight:600;
  color:white;
}

.quiz-body{
  padding:24px;
}

.quiz-question{
  color:white;
  font-size:18px;
  font-weight:600;
  margin-bottom:22px;
  line-height:1.6;
}

.quiz-option{
  width:100%;
  border:none;
  border-radius:16px;
  padding:14px 18px;
  margin-bottom:12px;
  background:#1e293b;
  color:white;
  text-align:left;
  transition:0.25s;
  font-weight:500;
}

.quiz-option:hover{
  background:#334155;
}

.quiz-option.correct{
  background:#16a34a !important;
}

.quiz-option.wrong{
  background:#dc2626 !important;
}

.quiz-status{
  margin-top:18px;
  font-weight:600;
  color:white;
}

.quiz-progress{
  height:8px;
  background:#1e293b;
  overflow:hidden;
}

.quiz-progress-bar{
  height:100%;
  width:100%;
  background:#22c55e;
  transition:1s linear;
}

.code-editor{
  background:#020617;
  color:#38bdf8;
  border:none;
  border-radius:16px;
  padding:18px;
  font-family:monospace;
  min-height:220px;
  resize:none;
}

.retry-box{
  background:#7c2d12;
  color:white;
  padding:12px;
  border-radius:12px;
  margin-top:15px;
}

/* =========================
   MOBILE APP UI
========================= */

@media(max-width:768px){

  body{
    background:#eef2f7;
  }

  h4.fw-bold{
    font-size:18px !important;
    margin-bottom:14px !important;
  }

  /* VIDEO */

  .video-card{

    border-radius:22px !important;

    padding:8px !important;

    overflow:hidden;

    box-shadow:
      0 8px 24px rgba(15,23,42,0.08);

  }

  .youtube-frame{
    border-radius:16px !important;
  }

  /* BUTTON */

  .btn{

    border-radius:14px !important;

    font-size:13px !important;

    font-weight:600 !important;

    height:46px;

  }

  /* QUIZ */

  .quiz-card{

    border-radius:22px !important;

    overflow:hidden;

  }

  .quiz-header{

    padding:14px 16px !important;

  }

  .quiz-title{
    font-size:15px !important;
  }

  .quiz-timer{
    font-size:13px !important;
  }

  .quiz-body{
    padding:16px !important;
  }

  .quiz-question{

    font-size:15px !important;

    line-height:1.5;

    margin-bottom:16px !important;

  }

  .quiz-option{

    border-radius:14px !important;

    padding:12px 14px !important;

    font-size:13px !important;

    margin-bottom:10px !important;

  }

  .code-editor{

    min-height:180px;

    border-radius:14px !important;

    font-size:13px !important;

    padding:14px !important;

  }

  /* DISCUSSION */

  .notes-card{

    border-radius:22px !important;

    padding:16px !important;

    box-shadow:
      0 6px 24px rgba(15,23,42,0.06);

  }

  .notes-card h5{
    font-size:16px !important;
  }

  textarea.form-control{

    border-radius:14px !important;

    font-size:13px !important;

    padding:12px !important;

  }

  .comment-item{

    border-radius:18px !important;

    padding:14px !important;

  }

  .comment-item .text-white{
    font-size:13px !important;
    line-height:1.6;
  }

  .comment-item .small{
    font-size:10px !important;
  }

  /* PLAYLIST */

  .playlist-card{

    border-radius:22px !important;

    padding:16px !important;

    margin-top:2px;

  }

  .playlist-card h5{
    font-size:16px !important;
  }

  .playlist-item{

    border-radius:18px !important;

    padding:10px !important;

    margin-bottom:12px !important;

  }

  .playlist-item img{

    width:95px !important;

    height:62px !important;

    border-radius:12px !important;

  }

  .playlist-item .fw-semibold{

    font-size:13px !important;

    line-height:1.5;

  }

  .playlist-item .small{

    font-size:10px !important;

  }

  /* NOTES */

  .notes-card a{

    padding:12px !important;

    border-radius:14px !important;

  }

  .notes-card a .fw-semibold{
    font-size:13px !important;
  }

  .notes-card small{
    font-size:10px !important;
  }

  /* BADGES */

  .badge{

    font-size:10px !important;

    padding:7px 10px !important;

    border-radius:10px !important;

  }

  /* AVATAR */

  .rounded-circle{

    width:40px !important;
    height:40px !important;
    min-width:40px !important;

    font-size:13px !important;

  }

  /* REPORT BUTTON */

  .btn-outline-danger.rounded-circle{

    width:34px !important;
    height:34px !important;

    padding:0 !important;

  }

  /* SPACING */

  .mb-4{
    margin-bottom:14px !important;
  }

  .mb-3{
    margin-bottom:12px !important;
  }

  .p-4{
    padding:16px !important;
  }

  .gap-3{
    gap:10px !important;
  }

}
