<h4 class="fw-bold mb-3">🎬 <%= course.title %></h4>

<div class="row g-4 align-items-start">

<!-- VIDEO -->
<div class="col-lg-8">

  <div class="video-card p-2 mb-3">
    <div class="ratio ratio-16x9">
<iframe
  id="player"
  class="youtube-frame"
  src="https://www.youtube.com/embed/<%= startVideo.youtube_video_id %>?enablejsapi=1&playsinline=0&rel=0&modestbranding=1&controls=1&fs=1&iv_load_policy=3&cc_load_policy=0"
  title="YouTube video player"
  frameborder="0"
  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
  allowfullscreen>
</iframe>
    </div>
  </div>

  <button onclick="markComplete()" class="btn btn-success w-100 mb-3">
    ✔ Mark Completed
  </button>

  <!-- QUIZ -->
<div id="quizSection" style="display:none;" class="mb-3">

  <div class="quiz-card">

    <div class="quiz-header">

      <div class="quiz-title">
        🧠 Lesson Quiz
      </div>

      <div class="quiz-timer" id="quizTimer">
        60s
      </div>

    </div>

    <div class="quiz-progress">
      <div class="quiz-progress-bar" id="quizProgressBar"></div>
    </div>

    <div class="quiz-body">

      <div id="quizContainer"></div>

      <div id="quizStatus" class="quiz-status"></div>

    </div>

  </div>

</div>

<!-- COMMENTS -->
<!-- COMMENTS -->
<div class="notes-card discussion-card p-4 mt-3">

  <!-- HEADER -->

  <div class="discussion-header">

    <div>

      <h5 class="discussion-title">
        💬 Discussion & Doubts
      </h5>

      <div class="discussion-subtitle">
        Ask doubts & connect with students
      </div>

    </div>

    <div class="discussion-count">
      <%= comments.length %>
    </div>

  </div>

  <!-- COMMENT FORM -->

  <form
    method="POST"
    action="/comment"
    class="discussion-form"
  >

    <input
      type="hidden"
      name="courseId"
      value="<%= course.id %>"
    >

    <div class="discussion-input-wrap">

      <!-- USER -->

      <div class="discussion-avatar">

        <%= user.name.charAt(0).toUpperCase() %>

      </div>

      <!-- INPUT -->

      <div class="discussion-input-box">

        <textarea
          class="discussion-textarea"
          name="message"
          rows="2"
          placeholder="Ask your doubt..."
          required
        ></textarea>

        <button
          class="discussion-send-btn"
        >
          <i class="bi bi-send-fill"></i>
        </button>

      </div>

    </div>

  </form>

  <!-- COMMENTS -->

  <div class="discussion-comments">

    <% if(comments.length === 0){ %>

      <div class="discussion-empty">

        <i class="bi bi-chat-square-text"></i>

        <p>
          No discussions yet
        </p>

      </div>

    <% } %>

    <% comments.forEach(c => { %>

      <div class="discussion-item">

        <!-- TOP -->

        <div class="discussion-top">

          <div class="discussion-user">

            <!-- AVATAR -->

            <div class="discussion-avatar">

              <%= (c.user_name || "U")
              .charAt(0)
              .toUpperCase() %>

            </div>

            <!-- INFO -->

            <div>

              <div class="discussion-name">

                <%= c.user_name || "Student" %>

              </div>

              <div class="discussion-time">

                <i class="bi bi-clock"></i>

                <%= new Date(
                  c.created_at
                ).toLocaleString() %>

              </div>

            </div>

          </div>

          <!-- REPORT -->

          <button
            class="discussion-report-btn"
            onclick="reportComment(<%= c.id %>)"
          >
            <i class="bi bi-flag"></i>
          </button>

        </div>

        <!-- MESSAGE -->

        <div class="discussion-message">

          <%= c.message %>

        </div>

      </div>

    <% }) %>

  </div>

</div>
  </div>



<!-- PLAYLIST -->
<div class="col-lg-4">

  <!-- PLAYLIST CARD -->
  <div
    class="playlist-card mb-4"
    style="
      background:#0f172a;
      border-radius:24px;
      padding:20px;
      border:1px solid rgba(255,255,255,0.06);
      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    "
  >

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

      <h5 class="text-white fw-bold mb-0">
        📺 Course Playlist
      </h5>

      <span class="badge bg-primary rounded-pill px-3 py-2">
        <%= videos.length %> Videos
      </span>

    </div>

    <!-- VIDEOS -->
    <div
      style="
        max-height:600px;
        overflow-y:auto;
        padding-right:4px;
      "
    >

      <% videos.forEach((v, index) => { %>

      <%
        const prevVideo = videos[index - 1];
        const prevHasQuiz = prevVideo
  ? quizzes.some(q => q.video_id === prevVideo.id)
  : false;

const prevPassed = prevVideo
  ? (!prevHasQuiz || passedMap[prevVideo.id])
  : true;
        const isUnlocked = index === 0 || prevPassed;

        const isCompleted = completedIds.includes(v.id);
        const isActive = v.id === startVideo.id;
      %>

      <div
        id="video-<%= v.id %>"

        class="playlist-item mb-3
        <%= isActive ? 'playlist-active' : '' %>
        <%= !isUnlocked ? 'playlist-locked' : '' %>"

        <% if (isUnlocked) { %>
          onclick="playVideo('<%= v.youtube_video_id %>', <%= v.id %>)"
        <% } %>

        style="
          background:#1e293b;
          border-radius:18px;
          padding:12px;
          cursor:pointer;
          transition:0.25s;
          border:1px solid transparent;
        "
      >

        <div class="d-flex gap-3">

          <!-- THUMB -->
          <div style="position:relative;">

            <img
              src="<%= v.thumbnail || 'https://via.placeholder.com/120' %>"

              style="
                width:110px;
                height:70px;
                object-fit:cover;
                border-radius:12px;
              "
            >

            <!-- STATUS -->
            <div
              style="
                position:absolute;
                top:6px;
                right:6px;
              "
            >

              <% if (!isUnlocked) { %>

                <span class="badge bg-dark">
                  🔒
                </span>

              <% } else if (isCompleted) { %>

                <span class="badge bg-success">
                  ✔
                </span>

              <% } else { %>

                <span class="badge bg-primary">
                  ▶
                </span>

              <% } %>

            </div>

          </div>

          <!-- CONTENT -->
          <div class="flex-grow-1">

            <div
              class="text-white fw-semibold"
              style="
                line-height:1.5;
                font-size:15px;
              "
            >
              <%= v.title %>
            </div>

            <div
              class="small mt-2"
              style="color:#94a3b8;"
            >

              Lesson <%= index + 1 %>

              <% if (isCompleted) { %>

                • Completed

              <% } else if (!isUnlocked) { %>

                • Locked

              <% } else { %>

                • Ready to watch

              <% } %>

            </div>

          </div>

        </div>

      </div>

      <% }) %>

    </div>

  </div>

  <!-- NOTES CARD -->
  <div
    class="notes-card p-4 text-white"
    style="
      border-radius:24px;
      background:#0f172a;
      border:1px solid rgba(255,255,255,0.06);
      box-shadow:0 10px 30px rgba(0,0,0,0.25);
    "
  >

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

      <h5 class="fw-bold mb-0">
        📁 Study Notes
      </h5>

      <span class="badge bg-info rounded-pill px-3 py-2">
        <%= notes.length %> Files
      </span>

    </div>

    <!-- EMPTY -->
    <% if (!notes || notes.length === 0) { %>

      <div class="text-center py-4 text-light opacity-75">

        <i class="bi bi-file-earmark-text fs-1"></i>

        <p class="mt-2 mb-0">
          No notes uploaded yet
        </p>

      </div>

    <% } %>

    <!-- FILES -->
<% notes.forEach(n => { %>

<a
  href="https://edu-platform-rywx.onrender.com/uploads/<%= encodeURIComponent(n.file_url) %>"
  
  target="_blank"
  rel="noopener noreferrer"

  class="d-flex align-items-center justify-content-between
