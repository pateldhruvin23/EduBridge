              align-items:center;
              justify-content:center;
              font-size:18px;
            "
          >
            📄
          </div>

          <div>

            <div class="fw-semibold">
              <%= n.title %>
            </div>

            <small style="color:#94a3b8;">
              Study Material
            </small>

          </div>

        </div>

        <i class="bi bi-download"></i>

      </a>

    <% }) %>

  </div>

</div>
