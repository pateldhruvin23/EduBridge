<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Unblock Request</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>

    body{
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background:linear-gradient(135deg,#0f172a,#1e293b,#334155);
      font-family:"Segoe UI",sans-serif;
      padding:20px;
    }

    .card-box{
      width:100%;
      max-width:520px;
      background:rgba(255,255,255,0.08);
      backdrop-filter:blur(18px);
      border:1px solid rgba(255,255,255,0.12);
      border-radius:28px;
      padding:35px;
      color:white;
      box-shadow:0 10px 40px rgba(0,0,0,0.25);
    }

    .logo{
      width:85px;
      height:85px;
      margin:auto;
      border-radius:24px;
      background:linear-gradient(135deg,#2563eb,#7c3aed);
      display:flex;
      justify-content:center;
      align-items:center;
      font-size:38px;
      margin-bottom:20px;
    }

    video,canvas{
      width:100%;
      border-radius:18px;
      border:2px solid rgba(255,255,255,0.1);
      margin-top:15px;
    }

    .form-control{
      height:52px;
      border:none;
      border-radius:14px;
      background:rgba(255,255,255,0.08);
      color:white;
    }

    .form-control::placeholder{
      color:#cbd5e1;
    }

    .form-control:focus{
      background:rgba(255,255,255,0.08);
      box-shadow:none;
      color:white;
    }

    .btn-modern{
      height:52px;
      border:none;
      border-radius:14px;
      font-weight:600;
    }

    .btn-capture{
      background:linear-gradient(135deg,#111827,#1f2937);
    }

    .btn-submit{
      background:linear-gradient(135deg,#2563eb,#7c3aed);
    }

  </style>

</head>

<body>

<div class="card-box">

  <div class="text-center">

    <div class="logo">
      <i class="bi bi-camera-video-fill"></i>
    </div>

    <h2 class="fw-bold">
      Account Verification
    </h2>

    <p class="text-light" style="opacity:0.8;">
      Verify your identity to request account unblock
    </p>

  </div>

  <video id="video" autoplay playsinline></video>

  <canvas id="canvas" style="display:none;"></canvas>

  <button
    class="btn btn-dark w-100 btn-modern btn-capture mt-3"
    onclick="captureFace()">

    <i class="bi bi-camera-fill"></i>
    Capture Face

  </button>

  <form method="POST" action="/submit-unblock-request">

    <input type="hidden" name="image" id="imageInput">

    <input
      type="password"
      name="password"
      class="form-control mt-3"
      placeholder="Confirm Password"
      required
    >

    <button class="btn btn-primary w-100 btn-modern btn-submit mt-3">

      <i class="bi bi-send-fill"></i>
      Submit Request

    </button>

  </form>

</div>

<script>

const video = document.getElementById("video");

navigator.mediaDevices.getUserMedia({
  video:true
})
.then(stream => {
  video.srcObject = stream;
});

function captureFace(){

  const canvas = document.getElementById("canvas");

  canvas.width = video.videoWidth;
  canvas.height = video.videoHeight;

  const ctx = canvas.getContext("2d");

  ctx.drawImage(video,0,0);

  const image = canvas.toDataURL("image/jpeg");

  document.getElementById("imageInput").value = image;

  alert("Face captured successfully");

}

</script>

</body>
</html>