<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
  />

  <title>Forgot Password</title>

  <!-- Bootstrap -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Icons -->
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      -webkit-tap-highlight-color:transparent;
    }

    html{
      height:100%;
    }

    body{
      min-height:100dvh;

      display:flex;
      justify-content:center;
      align-items:center;

      background:linear-gradient(
        135deg,
        #0f172a,
        #1e293b,
        #334155
      );

      font-family:"Segoe UI",sans-serif;

      overflow:hidden;

      position:relative;

      padding:16px;
    }

    @supports(padding:max(0px)){

      body{
        padding-top:max(16px, env(safe-area-inset-top));
        padding-bottom:max(16px, env(safe-area-inset-bottom));
        padding-left:max(16px, env(safe-area-inset-left));
        padding-right:max(16px, env(safe-area-inset-right));
      }

    }

    body::before{
      content:"";

      position:absolute;

      width:500px;
      height:500px;

      background:#2563eb;

      border-radius:50%;

      top:-220px;
      left:-180px;

      filter:blur(120px);

      opacity:0.35;
    }

    body::after{
      content:"";

      position:absolute;

      width:420px;
      height:420px;

      background:#7c3aed;

      border-radius:50%;

      bottom:-220px;
      right:-160px;

      filter:blur(120px);

      opacity:0.28;
    }

    .card-box{
      width:100%;
      max-width:430px;

      background:rgba(255,255,255,0.08);

      backdrop-filter:blur(20px);
      -webkit-backdrop-filter:blur(20px);

      border:1px solid rgba(255,255,255,0.12);

      border-radius:32px;

      padding:36px 30px;

      color:white;

      box-shadow:
        0 10px 40px rgba(0,0,0,0.25);

      position:relative;
      z-index:10;
    }

    .logo{
      width:82px;
      height:82px;

      margin:auto;

      border-radius:24px;

      background:linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );

      display:flex;
      justify-content:center;
      align-items:center;

      font-size:36px;

      margin-bottom:22px;

      box-shadow:
        0 10px 30px rgba(37,99,235,0.4);
    }

    .main-title{
      font-size:30px;
      font-weight:800;
      margin-bottom:8px;
    }

    .subtitle{
      color:#cbd5e1;
      font-size:15px;
      line-height:1.6;
    }

    .input-group{
      background:rgba(255,255,255,0.08);

      border-radius:18px;

      overflow:hidden;

      border:1px solid rgba(255,255,255,0.08);

      transition:0.25s;
    }

    .input-group:focus-within{
      border-color:rgba(147,197,253,0.7);

      box-shadow:
        0 0 0 4px rgba(59,130,246,0.15);
    }

    .input-group-text{
      background:transparent;
      border:none;
      color:#cbd5e1;
      padding-left:16px;
      font-size:18px;
    }

    .form-control{
      background:transparent !important;
      border:none !important;
      color:white !important;

      height:58px;

      font-size:15px;

      box-shadow:none !important;
    }

    .form-control::placeholder{
      color:#cbd5e1;
    }

    .btn-modern{
      height:58px;

      border:none;

      border-radius:18px;

      background:linear-gradient(
        135deg,
        #2563eb,
        #7c3aed
      );

      font-weight:700;

      transition:0.3s;

      touch-action:manipulation;
    }

    .btn-modern:hover{
      transform:translateY(-2px);

      box-shadow:
        0 10px 25px rgba(37,99,235,0.35);
    }

    .btn-modern:active{
      transform:scale(0.98);
    }

    .alert{
      border:none;
      border-radius:16px;
    }

    @media(max-width:480px){

      body{
        padding:12px;
      }

      .card-box{
        padding:28px 20px;
        border-radius:26px;
      }

      .logo{
        width:74px;
        height:74px;
        font-size:32px;
      }

      .main-title{
        font-size:25px;
      }

      .subtitle{
        font-size:14px;
      }

      .form-control,
      .btn-modern{
        height:56px;
      }

    }

  </style>

</head>

<body>

<div class="card-box">

  <div class="text-center">

    <div class="logo">
      <i class="bi bi-key-fill"></i>
    </div>

    <h2 class="main-title">
      Forgot Password
    </h2>

    <p class="subtitle">
      Enter your email to receive a reset link
    </p>

  </div>

  <% if (error) { %>

    <div class="alert alert-danger mt-3">
      <%= error %>
    </div>

  <% } %>

  <% if (success) { %>

    <div class="alert alert-success mt-3">
      <%= success %>
    </div>

  <% } %>

  <form
    method="POST"
    action="/forgot-password"
    class="mt-4"
  >

    <div class="input-group mb-3">

      <span class="input-group-text">
        <i class="bi bi-envelope-fill"></i>
      </span>

      <input
        type="email"
        name="email"
        class="form-control"
        placeholder="Enter your email"
        autocomplete="email"
        inputmode="email"
        autocapitalize="none"
        required
      >

    </div>

    <button class="btn btn-primary w-100 btn-modern">

      Send Reset Link

    </button>

  </form>

</div>

<script>

document.querySelectorAll(
  "button, a"
).forEach(el => {

  el.addEventListener(
    "touchstart",
    () => {},
    { passive:true }
  );

});

</script>

</body>
</html>