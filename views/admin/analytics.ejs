<h4 class="mb-4">📊 Analytics Dashboard</h4>

<div class="row g-3">

  <div class="col-md-3">
    <div class="card p-3 text-center bg-dark text-white">
      <h6>Total Users</h6>
      <h3><%= stats.totalUsers %></h3>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-3 text-center bg-dark text-white">
      <h6>Total Courses</h6>
      <h3><%= stats.totalCourses %></h3>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-3 text-center bg-dark text-white">
      <h6>Completion Rate</h6>
      <h3><%= stats.completionRate %>%</h3>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-3 text-center bg-dark text-white">
      <h6>Quiz Success</h6>
      <h3><%= stats.quizSuccess %>%</h3>
    </div>
  </div>

</div>

<hr class="my-4">

<h5>📚 Enrollments per Course</h5>

<table class="table table-dark table-striped mt-3">
  <thead>
    <tr>
      <th>Course</th>
      <th>Enrollments</th>
    </tr>
  </thead>
  <tbody>
    <% enrollments.forEach(c => { %>
      <tr>
        <td><%= c.title %></td>
        <td><%= c.count %></td>
      </tr>
    <% }) %>
  </tbody>
</table>