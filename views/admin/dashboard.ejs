<!DOCTYPE html>
<html>
<head>
   <meta charset="UTF-8">

 <meta name="google-site-verification" content="c3yDZqD0SPEwnA2G6IhpoR-BFenjk0dXavfjPU5TUcM" />
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>

    body {
      background: #f5f7fb;
      font-family: 'Segoe UI', sans-serif;
    }

    /* HEADER */
    .header-box {
      background: linear-gradient(135deg, #0d6efd, #6610f2);
      color: white;
      padding: 25px;
      border-radius: 15px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }

    /* STATS */
    .stat-card {
      border-radius: 15px;
      transition: 0.3s;
      background: white;
    }

    .stat-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0,0,0,0.08);
    }

    /* COURSE CARDS */
    .course-card {
      border-radius: 15px;
      transition: 0.3s;
      background: white;
    }

    .course-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }

    /* CARD */
    .main-card {
      border-radius: 15px;
      background: white;
    }

    /* ANIMATION */
    .fade-in {
      animation: fadeIn 0.5s ease-in;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

  </style>
</head>

<body>

<div class="container mt-4 fade-in">

  <!-- 🔥 HEADER -->
  <div class="header-box d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="fw-bold mb-1">Dashboard 🚀</h2>
      <p class="mb-0">Welcome back, Admin 👋</p>
    </div>

    <a href="/admin/add-course" class="btn btn-light">
      ➕ Add Course
    </a>
  </div>

  <!-- 📊 STATS -->
  <div class="row mb-4">

    <div class="col-md-4">
      <div class="stat-card p-4 shadow-sm">
        <h6 class="text-muted">📚 Total Courses</h6>
        <h2 class="fw-bold"><%= courses.length %></h2>
      </div>
    </div>

    <div class="col-md-4">
      <div class="stat-card p-4 shadow-sm">
        <h6 class="text-muted">📱 Total Reels</h6>
        <h2 class="fw-bold">--</h2>
      </div>
    </div>

    <div class="col-md-4">
      <div class="stat-card p-4 shadow-sm">
        <h6 class="text-muted">👥 Active Users</h6>
        <h2 class="fw-bold">--</h2>
      </div>
    </div>

  </div>

  <!-- 📚 COURSES -->
  <div class="main-card p-4 shadow-sm mb-4">

    <div class="d-flex justify-content-between mb-3">
      <h4>📚 Courses</h4>
      <a href="/admin/courses" class="btn btn-outline-primary btn-sm">
        View All
      </a>
    </div>

    <div class="row">

      <% courses.forEach(course => { %>

        <div class="col-md-4 mb-4">
          <div class="course-card p-3 shadow-sm h-100">

            <h5 class="fw-bold"><%= course.title %></h5>
            <p class="text-muted small">
              <%= course.description || "No description available" %>
            </p>
       <span class="badge bg-secondary mb-2" style="font-size: 12px; padding: 5px 8px;">
  ID: <%= course.id %>
</span>
           <div class="d-flex justify-content-between mt-3">
  <a href="/course/<%= course.id %>" class="btn btn-dark btn-sm">
    <i class="bi bi-eye"></i> View
  </a>

  <a href="/admin/edit-course/<%= course.id %>" class="btn btn-warning btn-sm">
    <i class="bi bi-pencil"></i>
  </a>

  <form action="/admin/delete-course/<%= course.id %>" method="POST">
    <button class="btn btn-danger btn-sm">
      <i class="bi bi-trash"></i>
    </button>
  </form>
</div>

          </div>
        </div>

      <% }) %>

    </div>

  </div>

  <!-- 📱 ADD REEL -->
  <div class="main-card p-4 shadow-sm">

    <h4 class="mb-3">📱 Add Reel</h4>

    <form action="/admin/add-reel" method="POST" class="row g-3">

      <div class="col-md-4">
        <input type="text" name="title" class="form-control" placeholder="Reel Title" required>
      </div>

      <div class="col-md-6">
        <input type="text" name="embed_url" class="form-control" placeholder="Instagram Embed URL" required>
      </div>

      <div class="col-md-2">
        <button class="btn btn-success w-100">
          Add Reel
        </button>
      </div>

    </form>

  </div>

</div>

<script>
document.querySelectorAll("form").forEach(form => {
  form.addEventListener("submit", () => {
    const btn = form.querySelector("button");
    if (btn) btn.innerText = "⏳ Processing...";
  });
});
</script>

</body>
</html>