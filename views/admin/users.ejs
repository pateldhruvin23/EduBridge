<h4 class="mb-4">👤 User Management</h4>

<table class="table table-dark table-striped">

  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>XP</th>
      <th>Status</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>
    <% users.forEach(u => { %>

      <tr>
        <td><%= u.name %></td>
        <td><%= u.email %></td>
        <td><%= u.xp %></td>
        <td>
          <% if (u.is_blocked) { %>
            <span class="badge bg-danger">Blocked</span>
          <% } else { %>
            <span class="badge bg-success">Active</span>
          <% } %>
        </td>

        <td>
          <form action="/admin/toggle-user/<%= u.id %>" method="POST">
            <button class="btn btn-sm <%= u.is_blocked ? 'btn-success' : 'btn-danger' %>">
              <%= u.is_blocked ? 'Unblock' : 'Block' %>
            </button>
          </form>
        </td>
      </tr>

    <% }) %>
  </tbody>

</table>