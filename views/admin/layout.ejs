<!DOCTYPE html>
<html>
<head>
 
  <meta charset="UTF-8">

 <meta name="google-site-verification" content="c3yDZqD0SPEwnA2G6IhpoR-BFenjk0dXavfjPU5TUcM" />

  <title>EduBridge</title>

  <title>Admin Panel</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background: #f1f5f9;
    }

    /* SIDEBAR */
    .sidebar {
      width: 240px;
      height: 100vh;
      position: fixed;
      background: #0f172a;
      color: white;
      padding: 20px;
    }

    .sidebar h4 {
      text-align: center;
      margin-bottom: 30px;
      font-weight: 600;
    }

    .sidebar a {
      display: block;
      padding: 12px;
      color: #cbd5e1;
      text-decoration: none;
      border-radius: 8px;
      margin-bottom: 8px;
      transition: 0.2s;
    }

    .sidebar a:hover {
      background: #1e293b;
      color: white;
    }

    .sidebar a.active {
      background: #2563eb;
      color: white;
    }

    /* MAIN */
    .main {
      margin-left: 240px;
    }

    /* NAVBAR */
    .topbar {
      background: white;
      padding: 15px 25px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    /* CONTENT */
    .content {
      padding: 25px;
    }

    /* CARD */
    .card-ui {
      background: white;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    /* FOOTER */
    .footer {
      text-align: center;
      padding: 15px;
      color: gray;
      font-size: 14px;
    }
  </style>
</head>

<body>

<!-- SIDEBAR -->
<!-- SIDEBAR -->
<div class="sidebar">

  <h5>
    <i class="bi bi-mortarboard-fill"></i>
    EduBridge Admin
  </h5>
  <hr class="text-secondary">

  <!-- CORE -->
  <a href="/admin/dashboard">
    <i class="bi bi-speedometer2"></i>
    Dashboard
  </a>

  <a href="/admin/analytics">
    <i class="bi bi-bar-chart"></i>
    Analytics
  </a>

  <!-- CONTENT -->
  <a href="/admin/courses">
    <i class="bi bi-book"></i>
    Courses
  </a>

  <a href="/admin/quizzes">
    <i class="bi bi-question-circle"></i>
    Quizzes
  </a>

  <a href="/admin/notes">
    <i class="bi bi-file-earmark"></i>
    Notes
  </a>

  <a href="/admin/reels">
    <i class="bi bi-camera-video"></i>
    Reels
  </a>

  <!-- USERS -->
  <a href="/admin/users">
    <i class="bi bi-people"></i>
    Users
  </a>

  <a href="/admin/unblock-requests">
    <i class="bi bi-shield-lock"></i>
    Unblock Requests
  </a>

  <!-- MODERATION -->
  <a href="/admin/reports">
    <i class="bi bi-flag"></i>
    Reports
  </a>

  <!-- SYSTEM -->
  <a href="/admin/notifications">
    <i class="bi bi-bell"></i>
    Notifications
  </a>

  <!-- SITE PAGES -->
  <hr class="text-secondary">

  <div
    class="text-uppercase small fw-bold mb-2"
    style="color:#94a3b8;"
  >
    Site Pages
  </div>

  <a href="/admin/site-pages">
    <i class="bi bi-file-earmark-text"></i>
    Manage Pages
  </a>

  <a href="/page/about" target="_blank">
    <i class="bi bi-info-circle"></i>
    About Page
  </a>

  <a href="/page/privacy-policy" target="_blank">
    <i class="bi bi-shield-check"></i>
    Privacy Policy
  </a>

  <a href="/page/terms" target="_blank">
    <i class="bi bi-journal-text"></i>
    Terms & Conditions
  </a>

  <a href="/page/contact" target="_blank">
    <i class="bi bi-envelope"></i>
    Contact Page
  </a>

  <hr class="text-secondary">

  <!-- BACK -->
  <a href="/">
    <i class="bi bi-arrow-left"></i>
    Back to App
  </a>

</div>

<!-- MAIN -->
<div class="main">

  <!-- NAVBAR -->
  <div class="topbar">
    <div><strong>Admin Panel</strong></div>

    <div>
      <span class="me-3"><i class="bi bi-person-circle"></i> Admin</span>
      <a href="/logout" class="btn btn-sm btn-danger">
        <i class="bi bi-box-arrow-right"></i> Logout
      </a>
    </div>
  </div>

  <!-- CONTENT -->
  <div class="content">
    <div class="card-ui">
      <%- body %>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="footer">
    © 2026 EduBridge | All rights reserved
  </div>

</div>
</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</html>