<h3 class="mb-4">
  📄 Site Pages
</h3>

<div class="row">

  <% pages.forEach(page => { %>

    <div class="col-md-6 mb-4">

      <div class="card border-0 shadow-sm rounded-4 p-4">

        <h5 class="fw-bold">
          <%= page.title %>
        </h5>

        <div class="text-muted mb-3">
          /<%= page.slug %>
        </div>

        <a
          href="/admin/edit-page/<%= page.id %>"
          class="btn btn-primary"
        >
          ✏ Edit Page
        </a>

      </div>

    </div>

  <% }) %>

</div>
